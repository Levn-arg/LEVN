---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Levn — Hacé crecer tu negocio sin sumar más horas de trabajo",
  description = "Menos tareas a mano. Más consultas. Más ventas. Pedí tu diagnóstico gratis.",
} = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="overflow-x-hidden">
    <slot />

    <script>
      // Aparición de secciones al entrar en pantalla.
      const revealed = new Set<Element>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting || revealed.has(entry.target)) continue;
            entry.target.classList.add("is-visible");
            revealed.add(entry.target);
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
      );

      document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
    </script>

    <script>
      // Escala cada pantalla de tamaño fijo ([data-fit] > hijo de data-w × data-h)
      // al ancho disponible, sin agrandarla nunca por encima de su tamaño real.
      const fits = document.querySelectorAll<HTMLElement>("[data-fit]");

      function applyFit(box: HTMLElement) {
        const inner = box.firstElementChild as HTMLElement | null;
        if (!inner) return;
        const w = Number(box.dataset.w);
        const h = Number(box.dataset.h);
        const scale = Math.min(1, box.clientWidth / w);
        inner.style.width = `${w}px`;
        inner.style.height = `${h}px`;
        inner.style.transform = `scale(${scale})`;
        box.style.height = `${h * scale}px`;
      }

      const resizeObserver = new ResizeObserver((entries) => {
        for (const entry of entries) applyFit(entry.target as HTMLElement);
      });
      fits.forEach((box) => {
        applyFit(box);
        resizeObserver.observe(box);
      });
    </script>

    <script>
      // Estados antes → después de cada pantalla (.scr[data-steps]).
      // Cambian con el scroll: paso 1 cuando el centro de la pantalla pasa el
      // 35% del recorrido del viewport, paso 2 al 65%. Los botones de la
      // leyenda fuerzan un estado hasta el próximo cambio por scroll.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isMobile = window.matchMedia("(max-width: 899px)").matches;
      const screens = document.querySelectorAll<HTMLElement>(".scr[data-steps]");
      const lastComputed = new WeakMap<HTMLElement, number>();

      function computeState(scr: HTMLElement) {
        const steps = Number(scr.dataset.steps);
        if (reduceMotion || scr.dataset.trigger === "load") return steps - 1;
        const rect = scr.getBoundingClientRect();
        const progress = 1 - (rect.top + rect.height / 2) / window.innerHeight;
        const thresholds = steps === 2 ? [0.35] : [0.35, 0.65];
        return thresholds.filter((t) => progress >= t).length;
      }

      function update() {
        for (const scr of screens) {
          const next = computeState(scr);
          if (lastComputed.get(scr) === next) continue;
          lastComputed.set(scr, next);
          scr.dataset.estado = String(next);
        }
      }

      function setDevice(scr: HTMLElement, device: string) {
        scr.dataset.dev = device;
        scr.querySelectorAll<HTMLButtonElement>("[data-dev-pick]").forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.devPick === device));
        });
      }

      for (const scr of screens) {
        if (isMobile && scr.dataset.devMobile) setDevice(scr, scr.dataset.devMobile);

        scr.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) => {
          button.addEventListener("click", () => {
            scr.dataset.estado = button.dataset.step;
          });
        });

        scr.querySelectorAll<HTMLButtonElement>("[data-dev-pick]").forEach((button) => {
          button.addEventListener("click", () => {
            setDevice(scr, button.dataset.devPick!);
            if (scr.dataset.estado === "0") scr.dataset.estado = "1";
          });
        });
      }

      // El hero arranca en "antes" y pasa a "después" apenas carga la página.
      requestAnimationFrame(() => requestAnimationFrame(update));
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    </script>
  </body>
</html>
