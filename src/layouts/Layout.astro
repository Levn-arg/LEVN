---
import "../styles/global.css";
import { LANG_STORAGE_KEY, useTranslations } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
}

const t = useTranslations("es");
const { title = t.meta.title, description = t.meta.description } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FFF7E6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#110E1A" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ LANG_STORAGE_KEY }}>
      // Antes de pintar: marca que hay JS y aplica el tema guardado (o el del
      // sistema) para que no parpadee en claro al cargar en modo oscuro.
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        var dark = false;
        try {
          var saved = localStorage.getItem("levn-theme");
          dark = saved ? saved === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        } catch (e) {}
        root.classList.toggle("dark", dark);

        // Idioma guardado: si es inglés, se oculta la página hasta que el
        // traductor termine (evita ver el español un instante). Si algo
        // falla, se muestra igual a los 2,5 s.
        try {
          if (localStorage.getItem(LANG_STORAGE_KEY) === "en") {
            root.lang = "en";
            root.classList.add("i18n-pending");
            setTimeout(function () {
              root.classList.remove("i18n-pending");
            }, 2500);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="overflow-x-hidden">
    <slot />

    <script>
      import "../i18n/translator";
    </script>

    <script>
      // Aparición de secciones al entrar en pantalla.
      const revealed = new Set<Element>();
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting || revealed.has(entry.target)) continue;
            entry.target.classList.add("is-visible");
            revealed.add(entry.target);
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
      );

      document.querySelectorAll("[data-reveal]").forEach((el) => observer.observe(el));
    </script>

    <script>
      // Escala cada pantalla de tamaño fijo ([data-fit] > hijo de data-w × data-h)
      // al ancho disponible, sin agrandarla nunca por encima de su tamaño real.
      const fits = document.querySelectorAll<HTMLElement>("[data-fit]");

      function applyFit(box: HTMLElement) {
        const inner = box.firstElementChild as HTMLElement | null;
        if (!inner) return;
        const w = Number(box.dataset.w);
        const h = Number(box.dataset.h);
        const scale = Math.min(1, box.clientWidth / w);
        inner.style.width = `${w}px`;
        inner.style.height = `${h}px`;
        inner.style.transform = `scale(${scale})`;
        box.style.height = `${h * scale}px`;
      }

      const resizeObserver = new ResizeObserver((entries) => {
        for (const entry of entries) applyFit(entry.target as HTMLElement);
        window.dispatchEvent(new Event("levn:fit"));
      });
      fits.forEach((box) => {
        applyFit(box);
        resizeObserver.observe(box);
      });
    </script>

    <script>
      // Estados antes → después de cada pantalla (.scr[data-steps]).
      //
      // En desktop, las secciones de servicio ([data-pin]) se fijan en el
      // centro del viewport al llegar a él y quedan quietas mientras el scroll
      // avanza los pasos de su pantalla; al terminar, la página sigue.
      // En mobile (o si la sección no entra en pantalla) cambian por umbral:
      // paso 1 cuando el centro de la pantalla pasa el 35% del viewport,
      // paso 2 al 65%. Los botones de la leyenda fuerzan un estado hasta el
      // próximo cambio por scroll.
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isMobile = window.matchMedia("(max-width: 899px)").matches;
      const desktop = window.matchMedia("(min-width: 900px)");
      const screens = document.querySelectorAll<HTMLElement>(".scr[data-steps]");
      const lastComputed = new WeakMap<HTMLElement, number>();
      // Recorrido de scroll (en altos de viewport) que dura fijada la sección.
      const PIN_DISTANCE: Record<number, number> = { 2: 0.7, 3: 1.3 };
      const PIN_THRESHOLDS: Record<number, number[]> = { 2: [0.3], 3: [0.15, 0.6] };

      const pins = [...document.querySelectorAll<HTMLElement>("[data-pin]")].map((pin) => ({
        pin,
        section: pin.firstElementChild as HTMLElement,
        scr: pin.querySelector<HTMLElement>(".scr[data-steps]"),
      }));
      const pinOf = new Map(pins.filter((p) => p.scr).map((p) => [p.scr!, p]));

      function layoutPins() {
        for (const { pin, section, scr } of pins) {
          const height = section.offsetHeight;
          const enabled = !!scr && desktop.matches && !reduceMotion && height <= window.innerHeight;
          pin.classList.toggle("is-pinned", enabled);
          if (!enabled) {
            pin.style.height = "";
            continue;
          }
          const extra = PIN_DISTANCE[Number(scr!.dataset.steps)] * window.innerHeight;
          const top = (window.innerHeight - height) / 2;
          pin.dataset.extra = String(extra);
          pin.style.setProperty("--pin-top", `${top}px`);
          pin.style.height = `${height + extra}px`;
        }
      }

      function computeState(scr: HTMLElement) {
        const steps = Number(scr.dataset.steps);
        if (reduceMotion || scr.dataset.trigger === "load") return steps - 1;

        const pinned = pinOf.get(scr);
        if (pinned?.pin.classList.contains("is-pinned")) {
          const top = parseFloat(pinned.pin.style.getPropertyValue("--pin-top"));
          const progress = (top - pinned.pin.getBoundingClientRect().top) / Number(pinned.pin.dataset.extra);
          return PIN_THRESHOLDS[steps].filter((t) => progress >= t).length;
        }

        const rect = scr.getBoundingClientRect();
        const progress = 1 - (rect.top + rect.height / 2) / window.innerHeight;
        const thresholds = steps === 2 ? [0.35] : [0.35, 0.65];
        return thresholds.filter((t) => progress >= t).length;
      }

      function update() {
        for (const scr of screens) {
          const next = computeState(scr);
          if (lastComputed.get(scr) === next) continue;
          lastComputed.set(scr, next);
          scr.dataset.estado = String(next);
        }
      }

      function setDevice(scr: HTMLElement, device: string) {
        scr.dataset.dev = device;
        scr.querySelectorAll<HTMLButtonElement>("[data-dev-pick]").forEach((button) => {
          button.setAttribute("aria-pressed", String(button.dataset.devPick === device));
        });
      }

      for (const scr of screens) {
        if (isMobile && scr.dataset.devMobile) setDevice(scr, scr.dataset.devMobile);

        scr.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((button) => {
          button.addEventListener("click", () => {
            scr.dataset.estado = button.dataset.step;
          });
        });

        scr.querySelectorAll<HTMLButtonElement>("[data-dev-pick]").forEach((button) => {
          button.addEventListener("click", () => {
            setDevice(scr, button.dataset.devPick!);
            if (scr.dataset.estado === "0") scr.dataset.estado = "1";
          });
        });
      }

      // El hero arranca en "antes" y pasa a "después" apenas carga la página.
      layoutPins();
      requestAnimationFrame(() => requestAnimationFrame(update));
      window.addEventListener("scroll", update, { passive: true });
      // Las alturas cambian al escalar pantallas y al cargar las fuentes.
      for (const event of ["resize", "load", "levn:fit"]) {
        window.addEventListener(event, () => {
          layoutPins();
          update();
        });
      }
    </script>
  </body>
</html>
