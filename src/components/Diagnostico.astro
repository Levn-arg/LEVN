---
import ArrowIcon from "./ArrowIcon.astro";

const pasos = [
  { n: 1, t: "Charla de 45 min.", s: "Nos contás qué te frena.", d: "M4 5h16v11H9l-5 4z" },
  { n: 2, t: "Plan por escrito en 7 días.", s: "Qué se puede resolver, precio y plazo.", d: "M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6" },
  { n: 3, t: "Vos decidís.", s: "Sin compromiso. Si no te podemos ayudar, te lo decimos.", d: "M5 12.5l4.5 4.5L19 7.5" },
];
---

<section id="diagnostico" class="mx-auto max-w-360 px-21 pt-14 pb-24 max-[1100px]:px-10 max-[900px]:px-4 max-[900px]:pt-8 max-[900px]:pb-14">
  <div class="flex flex-col items-center gap-11 rounded-[32px] bg-accent-soft px-20 py-18 max-[1100px]:px-10 max-[900px]:items-stretch max-[900px]:gap-6 max-[900px]:rounded-[26px] max-[900px]:px-5 max-[900px]:py-9">
    <h2 class="m-0 text-center text-[52px] leading-[1.05] font-extrabold tracking-[-0.03em] max-[900px]:text-left max-[900px]:text-[34px] max-[900px]:leading-[1.06]">
      Una charla. Un plan claro.
    </h2>
    <ol class="m-0 grid w-full list-none grid-cols-3 gap-6 p-0 max-[900px]:grid-cols-1 max-[900px]:gap-3">
      {
        pasos.map((p) => (
          <li class="flex flex-col gap-3 rounded-3xl bg-white p-7 shadow-[0_20px_40px_-30px_rgba(108,60,224,0.5)] max-[900px]:flex-row max-[900px]:items-start max-[900px]:gap-4 max-[900px]:rounded-[20px] max-[900px]:p-5 max-[900px]:shadow-none">
            <div class="flex items-center justify-between">
              <div class="flex h-13 w-13 items-center justify-center rounded-2xl bg-accent text-white max-[900px]:h-11 max-[900px]:w-11 max-[900px]:rounded-[14px]">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="max-[900px]:h-5.5 max-[900px]:w-5.5">
                  <path d={p.d} />
                </svg>
              </div>
              <span class="text-sm font-bold text-muted-2 max-[900px]:hidden">Paso {p.n}</span>
            </div>
            <div class="flex flex-col gap-3 max-[900px]:gap-1">
              <div class="mt-1.5 text-[22px] leading-[1.25] font-extrabold max-[900px]:mt-0 max-[900px]:text-lg">{p.t}</div>
              <div class="text-[17px] leading-[1.45] text-muted max-[900px]:text-base">{p.s}</div>
            </div>
          </li>
        ))
      }
    </ol>
    <p class="m-0 text-[17px] font-semibold text-muted max-[900px]:text-base">Vos no cargás nada. Lo armamos todo.</p>
    <a
      class="btn inline-flex min-h-14.5 items-center gap-2.5 rounded-2xl bg-accent px-6.5 text-[17px] font-bold text-white no-underline shadow-[0_16px_32px_-14px_rgba(108,60,224,0.75)] max-[900px]:min-h-14 max-[900px]:justify-center"
      href="#contacto"
    >
      Quiero mi diagnóstico gratis
      <ArrowIcon />
    </a>
  </div>
</section>
