---
const channels = [
  {
    icon: "☎",
    iconBg: "bg-[#e7f8ee]",
    iconColor: "text-whatsapp",
    title: "WhatsApp directo",
    copy: "Escribinos y te respondemos al toque.",
    cta: "Escribir ahora →",
    ctaColor: "text-[#1fae5f]",
    href: "https://wa.me/5491112345678",
  },
  {
    icon: "▤",
    iconBg: "bg-accent-soft",
    iconColor: "text-accent",
    title: "Formulario corto",
    copy: "2 minutos y ya estamos en contacto.",
    cta: "Completar ahora →",
    ctaColor: "text-accent",
    href: "#formulario",
  },
  {
    icon: "📅",
    iconBg: "bg-accent-soft",
    iconColor: "text-accent",
    title: "Agenda una reunión",
    copy: "Si preferís, coordinamos una llamada.",
    cta: "Agendar llamada →",
    ctaColor: "text-accent",
    href: "#agenda",
  },
];
---

<section class="pt-17.5 px-12 max-[900px]:px-6" id="contacto">
  <p class="mb-3.5 flex items-center gap-2 text-[12px] font-bold tracking-[1px] text-accent">
    <span
      class="flex h-5 w-5 items-center justify-center rounded-full bg-ink text-[10px] text-white"
      >10</span
    >
    CONTACTO
  </p>
  <h2 class="mb-2.5 text-[28px] font-extrabold">Empecemos con<br />un diagnóstico.</h2>
  <p class="mb-6.5 max-w-85 text-[14px] text-muted-2">
    Contanos de tu negocio y te respondemos en menos de 24h hábiles.
  </p>

  <div class="grid grid-cols-4 gap-4.5 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1">
    {
      channels.map((channel) => (
        <a
          href={channel.href}
          class="block rounded-[20px] bg-white px-5.5 py-6.5 text-ink hover:text-ink"
        >
          <div
            class={`mb-4 flex h-10 w-10 items-center justify-center rounded-[12px] text-lg ${channel.iconBg} ${channel.iconColor}`}
          >
            {channel.icon}
          </div>
          <p class="mb-2 text-[15px] font-bold">{channel.title}</p>
          <p class="mb-4 text-[12.5px] text-muted-2">{channel.copy}</p>
          <span class={`text-[13px] font-bold ${channel.ctaColor}`}>
            {channel.cta}
          </span>
        </a>
      ))
    }

    <div class="rounded-[20px] bg-accent px-5.5 py-6.5 text-white">
      <p class="mb-3 text-[15px] font-extrabold">¿Qué pasa después? ✦</p>
      <p class="text-[12.5px] leading-[1.6] text-[#e6ddfb]">
        Te contactamos, hacemos el diagnóstico y te enviamos un plan claro y
        sin compromiso.
      </p>
    </div>
  </div>
</section>
