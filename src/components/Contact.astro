---
import ContactFormModal from "./ContactFormModal";
import ScheduleModal from "./ScheduleModal";

const whatsapp = {
  icon: "📱",
  iconBg: "bg-[#e7f8ee]",
  iconColor: "text-whatsapp",
  title: "WhatsApp directo",
  copy: "Escribinos y te respondemos al instante.",
  cta: "Escribir ahora →",
  ctaColor: "text-[#1fae5f]",
  href: "https://wa.me/5491158486166",
};
---

<section class="pt-17.5 px-12 max-[900px]:px-6" id="contacto" data-reveal>
  <p class="mb-3.5 flex items-center gap-2 text-[12px] font-bold tracking-[1px] text-accent">
    CONTACTO
  </p>
  <h2 class="mb-2.5 text-[28px] font-extrabold">Empecemos con<br />un diagnóstico.</h2>
  <p class="mb-6.5 max-w-85 text-[14px] text-muted-2">
    Contanos de tu negocio y te respondemos en menos de 24h hábiles.
  </p>

  <div class="grid grid-cols-4 gap-4.5 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1">
    <a
      href={whatsapp.href}
      target="_blank"
      rel="noopener noreferrer"
      class="block rounded-[20px] bg-white px-5.5 py-6.5 text-ink hover:text-ink"
    >
      <div
        class={`mb-4 flex h-10 w-10 items-center justify-center rounded-xl text-lg ${whatsapp.iconBg} ${whatsapp.iconColor}`}
      >
        {whatsapp.icon}
      </div>
      <p class="mb-2 text-[15px] font-bold">{whatsapp.title}</p>
      <p class="mb-4 text-[12.5px] text-muted-2">{whatsapp.copy}</p>
      <span class={`text-[13px] font-bold ${whatsapp.ctaColor}`}>
        {whatsapp.cta}
      </span>
    </a>

    <ContactFormModal client:load />
    <ScheduleModal client:load />

    <div class="rounded-[20px] bg-accent px-5.5 py-6.5 text-white">
      <p class="mb-3 text-[15px] font-extrabold">¿Qué pasa después? ✦</p>
      <p class="text-[12.5px] leading-[1.6] text-[#e6ddfb]">
        Te contactamos, hacemos el diagnóstico y te enviamos un plan claro y
        sin compromiso.
      </p>
    </div>
  </div>
</section>
