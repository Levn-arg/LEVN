---
// Botón de modo claro / oscuro. Puede haber varios en la página (header y
// menú mobile): todos se sincronizan. La elección se guarda en localStorage;
// sin elección, se sigue al sistema (ver el script inline de Layout.astro).
import { useTranslations } from "../i18n/ui";

interface Props {
  class?: string;
  // Muestra el nombre del modo al lado del ícono (menú mobile).
  withLabel?: boolean;
}

const { class: className, withLabel = false } = Astro.props;
const t = useTranslations("es").header;
---

<button
  type="button"
  data-theme-toggle
  data-label-dark={t.toDark}
  data-label-light={t.toLight}
  data-text-dark={t.darkMode}
  data-text-light={t.lightMode}
  aria-label={t.toDark}
  class:list={[
    "flex cursor-pointer items-center justify-center gap-2.5 border border-ink/10 bg-surface text-ink transition-colors hover:border-accent hover:text-accent",
    withLabel ? "min-h-12 rounded-2xl px-4 text-base font-bold" : "h-11 w-11 rounded-[14px]",
    className,
  ]}
>
  <!-- Luna en claro (pasa a oscuro), sol en oscuro (pasa a claro). -->
  <svg class="flex-none dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
  </svg>
  <svg class="hidden flex-none dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  {withLabel && <span data-theme-label class="whitespace-nowrap">{t.darkMode}</span>}
</button>

<script>
  const root = document.documentElement;
  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");

  function sync() {
    const dark = root.classList.contains("dark");
    toggles.forEach((button) => {
      const label = (dark ? button.dataset.labelLight : button.dataset.labelDark) ?? "";
      button.setAttribute("aria-label", label);
      const text = button.querySelector("[data-theme-label]");
      if (text) text.textContent = (dark ? button.dataset.textLight : button.dataset.textDark) ?? "";
    });
  }

  function setTheme(dark: boolean) {
    // Sin transiciones durante el cambio, para que todo cambie a la vez.
    root.classList.add("theme-switching");
    root.classList.toggle("dark", dark);
    try {
      localStorage.setItem("levn-theme", dark ? "dark" : "light");
    } catch {}
    sync();
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("theme-switching")));
  }

  toggles.forEach((button) => button.addEventListener("click", () => setTheme(!root.classList.contains("dark"))));

  // Si no hay elección guardada, seguir los cambios del sistema en vivo.
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem("levn-theme");
    } catch {}
    if (!saved) {
      root.classList.toggle("dark", event.matches);
      sync();
    }
  });

  sync();
</script>
