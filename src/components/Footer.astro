---
const navLinks = ["Servicios", "Cómo trabajamos", "Proyectos", "Contacto"];
const legalLinks = ["Términos y condiciones", "Política de privacidad"];
const socials = ["◎", "in", "✕"];
---

<footer class="mt-17.5 border-t border-ink/10 py-11 px-12 max-[900px]:py-9 max-[900px]:px-6" data-reveal>
  <div class="flex flex-wrap justify-between gap-5 max-[900px]:flex-col">
    <div class="max-w-55">
      <a href="/" class="flex items-center text-ink hover:text-ink" aria-label="LEVN — inicio">
        <img
          src="/src/images/logo.svg"
          alt="Logo de LEVN"
          width="32"
          height="32"
          class="h-8 w-8"
          />
          <span class="text-[17px] font-extrabold">LEVN</span>
        </a>
        <p class="text-[12.5px] leading-normal text-muted-2">
        Soluciones digitales a medida para PyMEs.
      </p>
    </div>

    <div>
      <p class="mb-3 text-[13px] font-bold">Navegación</p>
      <p class="text-[12.5px] leading-[2.3] text-muted-2">
        {navLinks.map((link, i) => <Fragment>{link}{i < navLinks.length - 1 && <br />}</Fragment>)}
      </p>
    </div>

    <div>
      <p class="mb-3 text-[13px] font-bold">Legal</p>
      <p class="text-[12.5px] leading-[2.3] text-muted-2">
        {legalLinks.map((link, i) => <Fragment>{link}{i < legalLinks.length - 1 && <br />}</Fragment>)}
      </p>
    </div>

    <div>
      <p class="mb-3 text-[13px] font-bold">Contacto</p>
      <p class="mb-2.5 text-[12.5px] leading-[2.3] text-muted-2">
        hola@levn.com.ar<br />+54 11 1234 5678
      </p>
      <div class="flex gap-2.5">
        {
          socials.map((icon) => (
            <span class="flex h-6.5 w-6.5 items-center justify-center rounded-full bg-ink text-[12px] text-white">
              {icon}
            </span>
          ))
        }
      </div>
    </div>

    <p class="max-w-55 text-right text-[12px] text-muted-3 max-[900px]:max-w-none max-[900px]:text-left">
      © 2026 LEVN Agencia Digital.<br />Todos los derechos reservados.
    </p>
  </div>
</footer>
