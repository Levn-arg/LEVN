---
import { EMAIL, INSTAGRAM_URL, WHATSAPP_URL } from "../data/site";
---

<footer class="border-t border-ink/8">
  <div class="mx-auto flex max-w-360 flex-col gap-6 px-21 py-9 text-sm text-muted-2 max-[1100px]:px-10 max-[900px]:gap-5 max-[900px]:px-4 max-[900px]:pt-7">
    <div class="flex items-center justify-between max-[900px]:flex-col max-[900px]:items-start max-[900px]:gap-3.5">
      <div class="flex items-center gap-5 max-[900px]:flex-col max-[900px]:items-start max-[900px]:gap-3.5">
        <img src="/images/levn-logo.svg" alt="Levn" width="91" height="32" class="h-8 w-auto" />
        <span>levn.com.ar · Buenos Aires</span>
      </div>
      <div class="flex flex-wrap gap-6 font-semibold max-[900px]:gap-5">
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="text-muted no-underline hover:text-ink">WhatsApp</a>
        {
          INSTAGRAM_URL && (
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" class="text-muted no-underline hover:text-ink">
              Instagram
            </a>
          )
        }
        <a href={`mailto:${EMAIL}`} class="text-muted no-underline hover:text-ink">{EMAIL}</a>
      </div>
    </div>
    <div class="flex items-center justify-between border-t border-ink/6 pt-6 max-[900px]:flex-col max-[900px]:items-start max-[900px]:gap-3 max-[900px]:pt-5">
      <span>© 2026 Levn</span>
      <nav aria-label="Legal" class="flex flex-wrap gap-6 max-[900px]:gap-5">
        <a href="/privacidad/" class="text-muted-2 no-underline hover:text-ink">Política de privacidad</a>
        <a href="/terminos/" class="text-muted-2 no-underline hover:text-ink">Términos y condiciones</a>
      </nav>
    </div>
  </div>
</footer>
