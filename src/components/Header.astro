---
import { WHATSAPP_URL } from "../data/site";
import { navLinks, useTranslations } from "../i18n/ui";
import ThemeToggle from "./ThemeToggle.astro";
import LangToggle from "./LangToggle.astro";

// Todo se arma en español; el inglés lo aplica el traductor en el navegador.
const t = useTranslations("es");
const links = navLinks();
const ctaHref = "/#contacto";
---

<div
  data-site-header
  class="site-header fixed inset-x-0 top-0 z-40 border-b border-transparent bg-pearl/85 backdrop-blur-md transition-[transform,border-color,box-shadow] duration-300 ease-out"
>
  <header class="relative mx-auto flex h-22 max-w-360 items-center justify-between gap-6 px-21 max-[1100px]:px-10 max-[900px]:h-16 max-[900px]:px-4">
    <a href="/" aria-label={t.header.home} class="flex flex-none items-center">
      <img src="/images/levn-logo.svg" alt="Levn" width="114" height="40" class="h-10 w-auto dark:hidden max-[900px]:h-9" />
      <img src="/images/levn-logo-dark.svg" alt="Levn" width="114" height="40" class="hidden h-10 w-auto dark:block max-[900px]:h-9" />
    </a>

    <nav aria-label={t.header.main} class="flex gap-8 text-[15px] font-semibold max-[1240px]:gap-5 max-[1100px]:gap-4 max-[1100px]:text-sm max-[900px]:hidden">
      {
        // "Contacto" no va en la barra de escritorio: ya está el botón principal.
        links.slice(0, -1).map((link) => (
          <a href={link.href} class="whitespace-nowrap text-muted no-underline hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-none items-center gap-2.5 max-[900px]:hidden">
      <LangToggle />
      <ThemeToggle />
      <a
        class="btn ml-1.5 inline-flex min-h-12 items-center gap-2 rounded-[14px] bg-accent px-5 text-[15px] font-bold whitespace-nowrap text-white no-underline max-[1100px]:px-4"
        href={ctaHref}
        ><span class="max-[1100px]:hidden">{t.cta.diagnosis}</span><span class="hidden max-[1100px]:inline">{t.cta.diagnosisShort}</span></a
      >
    </div>

    <div class="hidden gap-2 max-[900px]:flex">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.header.whatsapp}
        class="flex h-11 w-11 items-center justify-center rounded-[14px] bg-whatsapp text-[#171225] hover:text-[#171225]"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg>
      </a>
      <button
        type="button"
        data-menu-toggle
        data-label-open={t.header.openMenu}
        data-label-close={t.header.closeMenu}
        aria-label={t.header.openMenu}
        aria-expanded="false"
        aria-controls="menu-mobile"
        class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-[14px] border border-ink/10 bg-surface text-ink"
      >
        <svg data-icon-open width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg data-icon-close hidden width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </header>
</div>
<div class="h-22 max-[900px]:h-16" aria-hidden="true"></div>

<!-- Menú mobile a pantalla completa. Va fuera de la barra: su backdrop-blur
     haría que un position: fixed interno se ubique relativo al header. -->
<nav
  id="menu-mobile"
  aria-label={t.header.main}
  hidden
  class="menu-mobile fixed inset-x-0 top-16 bottom-0 z-30 flex flex-col overflow-y-auto bg-pearl px-4 pt-4 pb-6"
>
  <ul class="m-0 flex list-none flex-col p-0">
    {
      links.map((link, i) => (
        <li class="menu-item border-b border-ink/7" style={`--i:${i}`}>
          <a
            href={link.href}
            class="flex min-h-14 items-center justify-between py-2 text-xl leading-tight font-bold text-ink no-underline hover:text-accent"
          >
            {link.label}
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-accent">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </li>
      ))
    }
  </ul>

  <a
    class="btn menu-item mt-6 flex min-h-14 flex-none items-center justify-center rounded-2xl bg-accent text-base font-bold text-white no-underline"
    style={`--i:${links.length}`}
    href={ctaHref}>{t.cta.diagnosis}</a
  >

  <div class="menu-item mt-4 grid flex-none grid-cols-2 gap-2.5" style={`--i:${links.length + 1}`}>
    <ThemeToggle withLabel class="w-full" />
    <LangToggle withLabel class="w-full" />
  </div>

  <!-- Isologo de Levn al pie del menú. -->
  <div class="flex min-h-40 flex-1 items-end justify-center pt-8" aria-hidden="true">
    <img src="/images/logo.svg" alt="" width="400" height="440" class="menu-logo h-auto w-36 opacity-90" />
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("menu-mobile");
  const iconOpen = toggle?.querySelector<SVGElement>("[data-icon-open]");
  const iconClose = toggle?.querySelector<SVGElement>("[data-icon-close]");
  const bar = document.querySelector<HTMLElement>("[data-site-header]")!;

  function isOpen() {
    return !!menu && !menu.hidden;
  }

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "");
    iconOpen?.toggleAttribute("hidden", open);
    iconClose?.toggleAttribute("hidden", !open);
    // Sin scroll de fondo mientras el menú ocupa la pantalla.
    document.documentElement.classList.toggle("menu-open", open);
    if (open) {
      setHidden(false);
      bar.dataset.scrolled = "true";
    } else {
      onScroll();
    }
  }

  toggle?.addEventListener("click", () => setOpen(!isOpen()));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen()) {
      setOpen(false);
      toggle?.focus();
    }
  });
  // Si se agranda la ventana a desktop con el menú abierto, se cierra.
  window.matchMedia("(min-width: 900px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });

  // Header fijo: se esconde al bajar y vuelve al subir, al acercar el mouse
  // al borde superior o al navegar con el teclado. Expone su alto visible en
  // --header-offset para que otros elementos fijos se acomoden debajo.
  let lastY = window.scrollY;

  function setHidden(hidden: boolean) {
    if (hidden && isOpen()) hidden = false;
    bar.dataset.hidden = String(hidden);
    document.documentElement.style.setProperty("--header-offset", hidden ? "0px" : `${bar.offsetHeight}px`);
  }

  function onScroll() {
    const y = window.scrollY;
    bar.dataset.scrolled = String(y > 8);
    if (y < 80) setHidden(false);
    else if (y > lastY + 4) setHidden(true);
    else if (y < lastY - 4) setHidden(false);
    lastY = y;
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("mousemove", (event) => {
    if (event.clientY < 80) setHidden(false);
  });
  bar.addEventListener("focusin", () => setHidden(false));
  onScroll();
</script>

<style>
  .site-header[data-hidden="true"] {
    transform: translateY(-100%);
  }

  .site-header[data-scrolled="true"] {
    border-bottom-color: color-mix(in srgb, var(--color-ink) 7%, transparent);
    box-shadow: 0 12px 30px -24px rgba(23, 18, 37, 0.35);
  }

  :global(html.menu-open),
  :global(html.menu-open body) {
    overflow: hidden;
  }

  /* Entrada del menú: el panel aparece y los ítems suben en cascada. */
  .menu-mobile:not([hidden]) {
    animation: menu-in 0.25s ease-out;
  }

  .menu-mobile:not([hidden]) .menu-item {
    animation: menu-item-in 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i, 0) * 45ms + 60ms);
  }

  .menu-mobile:not([hidden]) .menu-logo {
    animation: menu-item-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }
  }

  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .menu-mobile:not([hidden]),
    .menu-mobile:not([hidden]) .menu-item,
    .menu-mobile:not([hidden]) .menu-logo {
      transition: none;
      animation: none;
    }
  }
</style>
