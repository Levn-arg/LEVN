---
import { NAV_LINKS, WHATSAPP_URL } from "../data/site";
---

<div
  data-site-header
  class="site-header fixed inset-x-0 top-0 z-40 border-b border-transparent bg-pearl/85 backdrop-blur-md transition-[transform,border-color,box-shadow] duration-300 ease-out"
>
  <header class="relative mx-auto flex h-22 max-w-360 items-center justify-between px-21 max-[1100px]:px-10 max-[900px]:h-16 max-[900px]:px-4">
    <a href="/" aria-label="Levn, inicio" class="flex items-center">
      <img src="/images/levn-logo.svg" alt="Levn" width="114" height="40" class="h-10 w-auto max-[900px]:h-9" />
    </a>

    <nav aria-label="Principal" class="flex gap-8 text-[15px] font-semibold max-[1100px]:gap-5 max-[900px]:hidden">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="text-muted no-underline hover:text-ink">
            {link.label}
          </a>
        ))
      }
    </nav>

    <a
      class="btn inline-flex min-h-12 items-center gap-2 rounded-[14px] bg-accent px-5 text-[15px] font-bold text-white no-underline max-[900px]:hidden"
      href="/#diagnostico">Quiero mi diagnóstico gratis</a
    >

    <div class="hidden gap-2 max-[900px]:flex">
      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Escribir por WhatsApp"
        class="flex h-11 w-11 items-center justify-center rounded-[14px] bg-whatsapp text-ink hover:text-ink"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg>
      </a>
      <button
        type="button"
        data-menu-toggle
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-mobile"
        class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-[14px] border border-ink/10 bg-white text-ink"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
    </div>

    <nav
      id="menu-mobile"
      aria-label="Principal"
      hidden
      class="absolute top-16 right-4 left-4 z-40 flex flex-col gap-1 rounded-[22px] border border-ink/7 bg-white p-3 shadow-[0_24px_48px_-24px_rgba(108,60,224,0.45)]"
    >
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="flex min-h-12 items-center rounded-[14px] px-4 text-[17px] font-bold text-ink no-underline hover:bg-accent-soft hover:text-accent-hover">
            {link.label}
          </a>
        ))
      }
      <a
        class="btn mt-2 flex min-h-14 items-center justify-center rounded-2xl bg-accent text-[17px] font-bold text-white no-underline"
        href="/#diagnostico">Quiero mi diagnóstico gratis</a
      >
    </nav>
  </header>
</div>
<div class="h-22 max-[900px]:h-16" aria-hidden="true"></div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.getElementById("menu-mobile");

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  }

  toggle?.addEventListener("click", () => setOpen(menu?.hidden ?? false));
  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setOpen(false)));

  // Header fijo: se esconde al bajar y vuelve al subir, al acercar el mouse
  // al borde superior o al navegar con el teclado. Expone su alto visible en
  // --header-offset para que otros elementos fijos se acomoden debajo.
  const bar = document.querySelector<HTMLElement>("[data-site-header]")!;
  let lastY = window.scrollY;

  function setHidden(hidden: boolean) {
    if (hidden && (menu && !menu.hidden)) hidden = false;
    bar.dataset.hidden = String(hidden);
    document.documentElement.style.setProperty("--header-offset", hidden ? "0px" : `${bar.offsetHeight}px`);
  }

  function onScroll() {
    const y = window.scrollY;
    bar.dataset.scrolled = String(y > 8);
    if (y < 80) setHidden(false);
    else if (y > lastY + 4) setHidden(true);
    else if (y < lastY - 4) setHidden(false);
    lastY = y;
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("mousemove", (event) => {
    if (event.clientY < 80) setHidden(false);
  });
  bar.addEventListener("focusin", () => setHidden(false));
  onScroll();
</script>

<style>
  .site-header[data-hidden="true"] {
    transform: translateY(-100%);
  }

  .site-header[data-scrolled="true"] {
    border-bottom-color: rgba(23, 18, 37, 0.07);
    box-shadow: 0 12px 30px -24px rgba(23, 18, 37, 0.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
