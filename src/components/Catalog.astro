---
const catalogItems = [
  {
    icon: "👥",
    title: "Reactivación de clientes",
    copy: "Campaña automatizada sobre tu base de clientes olvidada.",
  },
  {
    icon: "🗂",
    title: "Landing + captación automatizada",
    copy: "Formulario → CRM → respuesta automática → aviso al dueño.",
  },
  {
    icon: "💬",
    title: "Chatbot + IA",
    copy: "Responde al instante y califica al interesado antes de pasarlo al vendedor.",
  },
  {
    icon: "📅",
    title: "Turnos con recordatorios automáticos",
    copy: "Baja las ausencias y mejora tu agenda.",
  },
  {
    icon: "📈",
    title: "Automatización de datos y reportes",
    copy: "Tus herramientas conectadas, reportes solos.",
  },
];
---

<section class="pt-16 px-12 max-[900px]:px-6" data-reveal>
  <p class="mb-3.5 flex items-center gap-2 text-[12px] font-bold tracking-[1px] text-accent">
    <span
      class="flex h-5 w-5 items-center justify-center rounded-full bg-ink text-[10px] text-white"
      >05</span
    >
    CATÁLOGO DE ARRANQUE
  </p>
  <h2 class="mb-6.5 text-[26px] font-extrabold">Problemas puntuales,<br />resueltos rápido.</h2>

  <div
    class="grid grid-cols-5 rounded-[26px] bg-panel px-2.5 py-8.5 text-white max-[900px]:grid-cols-2 max-[900px]:gap-y-6 max-[900px]:px-5 max-[900px]:py-7.5 max-[560px]:grid-cols-1"
  >
    {
      catalogItems.map((item) => (
        <div class="border-r border-white/12 px-4.5 last:border-none max-[900px]:border-none">
          <div class="mb-3.5 text-[22px]">{item.icon}</div>
          <p class="mb-2 text-[15px] font-bold">{item.title}</p>
          <p class="text-[12.5px] leading-normal text-ondark">{item.copy}</p>
        </div>
      ))
    }
  </div>
</section>
