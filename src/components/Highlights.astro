---
const audiences = [
  { icon: "🏬", label: "Comercios con clientela" },
  { icon: "💼", label: "Servicios profesionales (contadores, estudios)" },
  { icon: "🏠", label: "Inmobiliarias y concesionarias" },
  { icon: "📦", label: "Distribuidoras" },
  { icon: "✂️", label: "Rubros de turno (estética, salud, peluquería)" },
];

const differentiators = [
  {
    icon: "👥",
    title: "Un solo equipo para las 4 patas",
    copy: "Todo integrado, todo alineado a tu negocio.",
  },
  {
    icon: "🎯",
    title: "Hablamos de resultados, no de herramientas.",
    copy: "Medimos lo que importa.",
  },
  {
    icon: "🔀",
    title: "Nos adaptamos a vos, no al revés.",
    copy: "No usamos plantillas genéricas.",
  },
];
---

<section class="grid grid-cols-2 gap-5 pt-17.5 px-12 max-[900px]:grid-cols-1 max-[900px]:px-6" data-reveal>
  <div class="rounded-[22px] bg-white p-7.5">
    <p class="mb-3.5 flex items-center gap-2 text-[11px] font-bold tracking-[1px] text-accent">
      <span
        class="flex h-4.5 w-4.5 items-center justify-center rounded-full bg-ink text-[9px] text-white"
        >08</span
      >
      PARA QUIÉN
    </p>
    <p class="mb-4.5 text-[19px] font-extrabold">Con qué rubros trabajamos.</p>
    <ul class="text-[13.5px] leading-[2.4] text-[#3d3750]">
      {
        audiences.map((item) => (
          <li>
            <span aria-hidden="true">{item.icon}</span> {item.label}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="rounded-[22px] bg-white p-7.5">
    <p class="mb-3.5 flex items-center gap-2 text-[11px] font-bold tracking-[1px] text-accent">
      <span
        class="flex h-4.5 w-4.5 items-center justify-center rounded-full bg-ink text-[9px] text-white"
        >09</span
      >
      POR QUÉ NOSOTROS
    </p>
    <p class="mb-4.5 text-[19px] font-extrabold">Qué nos hace distintos.</p>
    <div class="flex flex-col gap-4">
      {
        differentiators.map((item) => (
          <div class="flex items-start gap-3">
            <div class="flex h-8.5 w-8.5 flex-none items-center justify-center rounded-[10px] bg-accent-soft text-[15px]">
              {item.icon}
            </div>
            <div>
              <p class="text-[14px] font-bold">{item.title}</p>
              <p class="mt-0.5 text-[12.5px] text-muted-2">{item.copy}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
