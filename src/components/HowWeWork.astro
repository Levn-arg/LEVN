---
const steps = [
  {
    icon: "🔍",
    title: "Diagnóstico",
    copy: "Mapeamos dónde perdés tiempo y dinero y salimos con un plan priorizado.",
  },
  {
    icon: "📄",
    title: "Propuesta clara",
    copy: "Alcance, precio y qué NO incluye. Sin cambios de precios ni sorpresas.",
  },
  {
    icon: "🗃",
    title: "Implementación por capas",
    copy: "Arrancamos por el problema más urgente.",
  },
  {
    icon: "♡",
    title: "Soporte y mejora continua",
    copy: "Abono mensual. No entregamos y chau.",
  },
];
---

<section class="pt-17.5 px-12 max-[900px]:px-6" id="como-trabajamos" data-reveal>
  <p class="mb-3.5 flex items-center gap-2 text-[12px] font-bold tracking-[1px] text-accent">
    CÓMO TRABAJAMOS
  </p>
  <h2 class="mb-8 text-[26px] font-extrabold">Así arrancamos.</h2>

  <div class="flex items-start max-[900px]:flex-col max-[900px]:items-stretch max-[900px]:gap-6">
    {
      steps.map((step, index) => (
        <>
          <div class="flex-1 text-center">
            <div class="mx-auto mb-3.5 flex h-16 w-16 items-center justify-center rounded-full bg-accent-soft text-2xl">
              {step.icon}
            </div>
            <p class="mb-1.5 text-[15px] font-bold">{step.title}</p>
            <p class="mx-auto max-w-40 text-[12.5px] leading-normal text-muted-2 max-[900px]:max-w-none">
              {step.copy}
            </p>
          </div>
          {index < steps.length - 1 && (
            <div class="pt-7 text-xl text-accent max-[900px]:hidden" aria-hidden="true">
              →
            </div>
          )}
        </>
      ))
    }
  </div>
</section>
