---
import Legend from "./Legend.astro";

// Presencia digital: búsqueda en Google → el sitio (con selector compu / tablet /
// celu) → consulta entrante.
const servicios = [
  { t: "Guardia 24 h", d: "Siempre hay alguien" },
  { t: "Vacunas", d: "Plan anual al día" },
  { t: "Peluquería", d: "Baño y corte" },
];
const devs = [
  ["compu", "Compu"],
  ["tablet", "Tablet"],
  ["celu", "Celu"],
];
const notif = "position:absolute; width:250px; box-sizing:border-box; padding:12px 14px; background:#FFFFFF; border-radius:18px; box-shadow:0 18px 40px -16px rgba(108,60,224,.45), 0 2px 6px rgba(23,18,37,.08); display:flex; gap:10px; align-items:center; z-index:6;";
const paw =
  "M12 11c-3 0-5.5 3.5-5.5 6 0 1.5 1.2 2.5 2.6 2.5 1.2 0 1.8-.6 2.9-.6s1.7.6 2.9.6c1.4 0 2.6-1 2.6-2.5 0-2.5-2.5-6-5.5-6z";
---

<div class="scr scr-web" data-steps="3" data-estado="0" data-dev="compu" data-dev-mobile="celu" style="position: relative; width: 820px; height: 580px; color: #171225">
  <div data-show="0" style="position: absolute; left: 30px; top: 0">
    <div style="width: 760px; height: 450px; box-sizing: border-box; padding: 10px; background: #15121F; border-radius: 20px 20px 8px 8px; box-shadow: 0 50px 90px -50px rgba(108,60,224,0.55)">
      <div style="width: 740px; height: 430px; border-radius: 10px; overflow: hidden; background: #FFFFFF">
        <div style="height: 34px; box-sizing: border-box; padding: 0 12px; background: #F4F3F6; border-bottom: 1px solid #E5E2EA; display: flex; align-items: center; gap: 12px">
          <div style="display: flex; gap: 5px"><div style="width: 10px; height: 10px; border-radius: 50%; background: #DDD9E3"></div><div style="width: 10px; height: 10px; border-radius: 50%; background: #DDD9E3"></div><div style="width: 10px; height: 10px; border-radius: 50%; background: #DDD9E3"></div></div>
          <div style="flex-grow: 1; max-width: 360px; height: 22px; border-radius: 6px; background: #FFFFFF; font-size: 11px; color: #6A6478; display: flex; align-items: center; padding: 0 10px">buscar › veterinaria en caballito</div>
        </div>
        <div style="padding: 16px 24px 0">
          <div style="width: 440px; height: 40px; box-sizing: border-box; border: 1px solid #E0DBE8; border-radius: 20px; padding: 0 16px; display: flex; align-items: center; justify-content: space-between; font-size: 14px; box-shadow: 0 4px 12px -8px rgba(23,18,37,0.25)">
            veterinaria en caballito
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6C3CE0" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="6"></circle><path d="M20 20l-4.5-4.5"></path></svg>
          </div>
          <div style="display: flex; gap: 18px; margin-top: 12px; font-size: 12px; color: #6A6478; border-bottom: 1px solid #EEEBF3"><span style="padding-bottom: 8px; color: #171225; font-weight: 700; border-bottom: 2px solid #171225">Todo</span><span>Mapas</span><span>Imágenes</span><span>Noticias</span></div>
          <div style="display: flex; gap: 20px; margin-top: 14px">
            <div style="width: 380px; display: flex; flex-direction: column; gap: 10px">
              <div style="padding: 10px 12px; border-radius: 12px; background: #F4EEFD; border: 1px solid #E2D6FA">
                <div style="font-size: 11px; color: #6A6478">sanroqueveterinaria.com.ar</div>
                <div style="font-size: 15px; font-weight: 700; color: #4E28B8; margin-top: 2px">Veterinaria San Roque · Guardia 24 h en Caballito</div>
                <div style="font-size: 12px; color: #4A4458; margin-top: 4px; line-height: 1.4">Consultas, vacunas y peluquería. Pedí turno online o por WhatsApp.</div>
              </div>
              <div style="padding: 0 12px; opacity: 0.55">
                <div style="font-size: 11px; color: #6A6478">clinicarivadavia.com.ar</div>
                <div style="font-size: 14px; font-weight: 700; color: #4A4458; margin-top: 2px">Clínica Veterinaria Rivadavia</div>
                <div style="font-size: 12px; color: #6A6478; margin-top: 3px">Atención con turno previo. Lunes a sábados.</div>
              </div>
              <div style="padding: 0 12px; opacity: 0.55">
                <div style="font-size: 11px; color: #6A6478">guiadeveterinarias.com</div>
                <div style="font-size: 14px; font-weight: 700; color: #4A4458; margin-top: 2px">Las 10 mejores veterinarias de Caballito</div>
                <div style="font-size: 12px; color: #6A6478; margin-top: 3px">Listado actualizado con direcciones y horarios.</div>
              </div>
            </div>
            <div style="width: 290px; border: 1px solid #E5E0EE; border-radius: 16px; overflow: hidden; box-shadow: 0 16px 30px -20px rgba(108,60,224,0.5)">
              <div style="position: relative; height: 80px; background: #E6EFE2; overflow: hidden">
                <div style="position: absolute; left: -20px; top: 34px; width: 340px; height: 10px; background: #FFFFFF; transform: rotate(-8deg)"></div>
                <div style="position: absolute; left: 150px; top: -10px; width: 10px; height: 110px; background: #FFFFFF; transform: rotate(12deg)"></div>
                <div style="position: absolute; left: 128px; top: 20px; color: #6C3CE0">
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="#6C3CE0" stroke="#FFFFFF" stroke-width="1.5" aria-hidden="true"><path d="M12 22s-7-6-7-12a7 7 0 0114 0c0 6-7 12-7 12z"></path><circle cx="12" cy="10" r="2.5" fill="#FFFFFF"></circle></svg>
                </div>
              </div>
              <div style="padding: 12px 14px; display: flex; flex-direction: column; gap: 4px">
                <div style="font-size: 15px; font-weight: 800">Veterinaria San Roque</div>
                <div style="font-size: 11px; display: flex; align-items: center; gap: 4px"><b>4,8</b><span style="color: #C98A00; letter-spacing: 1px">★★★★★</span><span style="color: #6A6478">(212)</span></div>
                <div style="font-size: 11px; color: #6A6478">Veterinaria · Av. Rivadavia 5100</div>
                <div style="font-size: 11px; color: #146C3A; font-weight: 700">Abierto · Cierra a las 21</div>
                <div style="display: flex; gap: 6px; margin-top: 8px">
                  <div style="flex-grow: 1; height: 30px; border-radius: 15px; background: #6C3CE0; color: #FFFFFF; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 0 4px rgba(108,60,224,0.2)">Sitio web</div>
                  <div style="flex-grow: 1; height: 30px; border-radius: 15px; border: 1px solid #DCD6E6; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center">Cómo llegar</div>
                  <div style="flex-grow: 1; height: 30px; border-radius: 15px; border: 1px solid #DCD6E6; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center">Llamar</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div style="width: 800px; height: 16px; margin-left: -20px; border-radius: 0 0 16px 16px; background: #2A2536; display: flex; justify-content: center"><div style="width: 120px; height: 6px; border-radius: 0 0 8px 8px; background: #15121F"></div></div>
  </div>

  <div data-show="1 2" style="position: absolute; left: 0; right: 0; top: 0">
    <div style="display: flex; justify-content: center">
      <div role="group" aria-label="Tamaño de pantalla" style="display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: #FFFFFF; border: 1px solid #E5E0EE; box-shadow: 0 8px 20px -14px rgba(108,60,224,0.5)">
        {
          devs.map(([k, l]) => (
            <button type="button" class="web-seg" data-dev-pick={k} aria-pressed={String(k === "compu")}>
              {l}
            </button>
          ))
        }
      </div>
    </div>
    <div style="display: flex; justify-content: center; margin-top: 12px">
      <div class="web-frame">
        <div class="web-inner">
          <div class="only-compu" style="height: 26px; box-sizing: border-box; padding: 0 10px; background: #F4F3F6; border-bottom: 1px solid #E5E2EA; align-items: center; gap: 10px">
            <div style="display: flex; gap: 4px"><div style="width: 8px; height: 8px; border-radius: 50%; background: #DDD9E3"></div><div style="width: 8px; height: 8px; border-radius: 50%; background: #DDD9E3"></div><div style="width: 8px; height: 8px; border-radius: 50%; background: #DDD9E3"></div></div>
            <div style="font-size: 10px; color: #6A6478; background: #FFFFFF; border-radius: 5px; padding: 2px 10px">sanroqueveterinaria.com.ar</div>
          </div>
          <div style="height: 44px; box-sizing: border-box; padding: 0 14px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #EDE6DA">
            <div style="display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 800; color: #0F6E63">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="#0F6E63" aria-hidden="true"><circle cx="7" cy="9" r="2"></circle><circle cx="17" cy="9" r="2"></circle><circle cx="10" cy="5.5" r="2"></circle><circle cx="14" cy="5.5" r="2"></circle><path d={paw}></path></svg>San Roque
            </div>
            <div class="not-celu" style="align-items: center; gap: 14px; font-size: 11px; color: #4A4458">
              <span class="only-compu-inline">Servicios</span><span class="only-compu-inline">Turnos</span><span class="only-compu-inline">Contacto</span>
              <span style="padding: 6px 10px; border-radius: 8px; background: #0F6E63; color: #FFFFFF; font-weight: 700">Pedir turno</span>
            </div>
            <svg class="only-celu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#171225" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          </div>
          <div class="web-hero">
            <div style="display: flex; flex-direction: column; gap: 8px">
              <div class="web-title">Cuidamos a tu mascota, también de noche.</div>
              <div style="font-size: 12px; line-height: 1.45; color: #4A4458">Guardia 24 h en Caballito. Turnos en el día.</div>
              <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px">
                <span class="web-wa">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg>Consultar por WhatsApp
                </span>
                <span style="display: inline-flex; align-items: center; height: 30px; padding: 0 10px; border-radius: 9px; border: 1px solid #D8D0C2; font-size: 11px; font-weight: 700">Ver servicios</span>
              </div>
            </div>
            <div class="web-img">
              <svg width="54" height="54" viewBox="0 0 24 24" fill="#0F6E63" style="opacity: 0.85" aria-hidden="true"><circle cx="7" cy="9" r="2"></circle><circle cx="17" cy="9" r="2"></circle><circle cx="10" cy="5.5" r="2"></circle><circle cx="14" cy="5.5" r="2"></circle><path d={paw}></path></svg>
              <div style="position: absolute; left: 10px; bottom: 10px; display: flex; align-items: center; gap: 5px; padding: 4px 9px; border-radius: 999px; background: #FFFFFF; font-size: 10px; font-weight: 700; color: #146C3A"><div style="width: 6px; height: 6px; border-radius: 50%; background: #1FA855"></div>Abierto ahora</div>
            </div>
          </div>
          <div class="web-serv">
            {
              servicios.map((s) => (
                <div style="border: 1px solid #EDE6DA; border-radius: 12px; padding: 10px; background: #FFFFFF">
                  <div style="font-size: 12px; font-weight: 700">{s.t}</div>
                  <div style="font-size: 10px; color: #6A6478; margin-top: 2px">{s.d}</div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div data-show="2" style={notif + "right:0; top:96px; --from:translateX(16px); --delay:350ms;"}>
    <div style="width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: #25D366; color: #171225; display: flex; align-items: center; justify-content: center">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg>
    </div>
    <div style="flex-grow: 1"><div style="font-size: 13px; font-weight: 700">Nueva consulta desde la web</div><div style="font-size: 12px; color: #6A6478">hace 1 min · Guardia</div></div>
  </div>

  <Legend steps={["Buscar", "Encontrar", "Consultar"]} style="left: 0px; right: 0px; top: 486px;" />
  <div style="position: absolute; left: 0px; right: 0px; top: 540px; text-align: center; font-size: 12px; font-weight: 500; color: #6A6478">Ejemplo ilustrativo</div>
</div>

<style>
  .web-seg {
    min-height: 40px;
    min-width: 80px;
    padding: 0 14px;
    border: 0;
    border-radius: 999px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    background: transparent;
    color: #4a4458;
    transition:
      background-color 300ms ease-out,
      color 300ms ease-out;
  }

  .web-seg[aria-pressed="true"] {
    background: #6c3ce0;
    color: #ffffff;
  }

  .web-frame {
    --t:
      width 700ms var(--ease), height 700ms var(--ease), padding 700ms var(--ease),
      border-radius 700ms var(--ease), background-color 400ms ease-out;
    box-sizing: border-box;
    overflow: hidden;
    box-shadow:
      0 40px 80px -40px rgba(108, 60, 224, 0.5),
      0 2px 8px rgba(23, 18, 37, 0.08);
    transition: var(--t);
    width: 720px;
    height: 400px;
    padding: 0;
    border-radius: 14px;
    background-color: #ffffff;
    border: 1px solid #e3deec;
  }

  .web-inner {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #fffdf8;
    border-radius: 13px;
    transition: var(--t);
  }

  .web-hero {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 14px;
    padding: 16px 14px 12px;
  }

  .web-title {
    font-size: 26px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: #10312d;
  }

  .web-img {
    position: relative;
    height: 180px;
    border-radius: 14px;
    background: #d7ede8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .web-serv {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 0 14px 14px;
  }

  .web-wa {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 30px;
    padding: 0 10px;
    border-radius: 9px;
    background: #25d366;
    color: #171225;
    font-size: 11px;
    font-weight: 700;
    transition: box-shadow 400ms ease-out;
  }

  .scr-web[data-estado="2"] .web-wa {
    box-shadow: 0 0 0 4px rgba(37, 211, 102, 0.35);
  }

  .only-compu,
  .not-celu {
    display: flex;
  }

  .only-celu,
  .only-compu-inline {
    display: none;
  }

  .scr-web[data-dev="compu"] .only-compu-inline {
    display: inline;
  }

  .scr-web:not([data-dev="compu"]) .only-compu,
  .scr-web[data-dev="celu"] .not-celu {
    display: none;
  }

  .scr-web[data-dev="celu"] .only-celu {
    display: block;
  }

  .scr-web[data-dev="tablet"] .web-frame {
    width: 460px;
    height: 400px;
    padding: 12px;
    border-radius: 30px;
    background-color: #15121f;
    border: 0;
  }

  .scr-web[data-dev="tablet"] .web-inner {
    border-radius: 18px;
  }

  .scr-web[data-dev="tablet"] .web-hero {
    grid-template-columns: 1fr 1fr;
  }

  .scr-web[data-dev="tablet"] .web-title {
    font-size: 22px;
  }

  .scr-web[data-dev="tablet"] .web-img {
    height: 140px;
  }

  .scr-web[data-dev="celu"] .web-frame {
    width: 230px;
    height: 410px;
    padding: 9px;
    border-radius: 38px;
    background-color: #15121f;
    border: 0;
  }

  .scr-web[data-dev="celu"] .web-inner {
    border-radius: 29px;
  }

  .scr-web[data-dev="celu"] .web-hero {
    grid-template-columns: 1fr;
  }

  .scr-web[data-dev="celu"] .web-title {
    font-size: 19px;
  }

  .scr-web[data-dev="celu"] .web-img {
    height: 96px;
  }

  .scr-web[data-dev="celu"] .web-serv {
    grid-template-columns: repeat(1, minmax(0, 1fr));
  }
</style>
