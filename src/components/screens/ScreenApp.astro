---
import Legend from "./Legend.astro";

// Desarrollo a medida: un wireframe en gris que pasa a ser la app real.
const btnBase = "flex-shrink:0; border-radius:9px; font-family:inherit; font-size:8px; font-weight:700; padding:6px 8px;";
const pill = "align-self:flex-start; font-size:10px; font-weight:700; padding:2px 8px; border-radius:999px;";
const foto = "width:60px; height:60px; flex-shrink:0; border-radius:12px; display:flex; align-items:center; justify-content:center;";
const clases = [
  {
    nombre: "Pilates reformer", hora: "18:00 · con Caro", cupo: "Quedan 3 lugares", btn: "Reservar",
    fotoSt: foto + "background:#E4D8FB; color:#6C3CE0;", pillSt: pill + "background:#E3F7EA; color:#146C3A;",
    btnSt: btnBase + "border:0; background:#6C3CE0; color:#FFFFFF;",
  },
  {
    nombre: "Yoga suave", hora: "19:30 · con Martín", cupo: "Completo", btn: "Avisarme",
    fotoSt: foto + "background:#FDE3C8; color:#9A4D00;", pillSt: pill + "background:#F1EFF4; color:#4A4458;",
    btnSt: btnBase + "border:1px solid #D9D3E6; background:#FFFFFF; color:#171225;",
  },
  {
    nombre: "Funcional", hora: "20:30 · con Juli", cupo: "Quedan 6 lugares", btn: "Reservar",
    fotoSt: foto + "background:#D6F0E0; color:#146C3A;", pillSt: pill + "background:#E3F7EA; color:#146C3A;",
    btnSt: btnBase + "border:0; background:#6C3CE0; color:#FFFFFF;",
  },
];
const scr = "position:absolute; inset:0; box-sizing:border-box; padding:48px 16px 0;";
const days = [["Lun", "12"], ["Mar", "13"], ["Mié", "14"], ["Jue", "15"]];
---

<div class="scr" data-steps="2" data-estado="0" style="position: relative; width: 380px; height: 700px; color: #171225">
  <div style="position: absolute; left: 40px; top: 0px; width: 300px; height: 620px; box-sizing: border-box; padding: 10px; background: #15121F; border-radius: 46px; box-shadow: 0 40px 80px -40px rgba(108,60,224,0.55), 0 4px 12px rgba(23,18,37,0.12)">
    <div style="position: relative; width: 280px; height: 600px; border-radius: 36px; overflow: hidden; background: #FFFFFF">
      <div style="position: absolute; top: 10px; left: 95px; width: 90px; height: 24px; border-radius: 999px; background: #15121F; z-index: 4"></div>

      <div data-show="0" style={scr + "background:#F4F3F6; --from:none;"} aria-hidden="true">
        <div style="display: flex; justify-content: space-between; align-items: center">
          <div style="display: flex; flex-direction: column; gap: 8px">
            <div style="width: 70px; height: 8px; border-radius: 4px; background: #DCD9E2"></div>
            <div style="width: 140px; height: 14px; border-radius: 4px; background: #C9C5D2"></div>
          </div>
          <div style="width: 36px; height: 36px; border-radius: 50%; border: 1.5px dashed #B9B4C4; box-sizing: border-box"></div>
        </div>
        <div style="display: flex; gap: 8px; margin-top: 16px">
          <div style="flex-grow: 1; height: 60px; border-radius: 14px; border: 1.5px dashed #B9B4C4; box-sizing: border-box"></div>
          <div style="flex-grow: 1; height: 60px; border-radius: 14px; border: 1.5px dashed #B9B4C4; box-sizing: border-box; background: #E6E3EB"></div>
          <div style="flex-grow: 1; height: 60px; border-radius: 14px; border: 1.5px dashed #B9B4C4; box-sizing: border-box"></div>
          <div style="flex-grow: 1; height: 60px; border-radius: 14px; border: 1.5px dashed #B9B4C4; box-sizing: border-box"></div>
        </div>
        <div style="width: 110px; height: 10px; border-radius: 4px; background: #DCD9E2; margin-top: 18px"></div>
        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px">
          {
            [1, 2, 3].map(() => (
              <div style="height: 80px; box-sizing: border-box; border-radius: 16px; border: 1.5px dashed #B9B4C4; padding: 8px; display: flex; gap: 10px; align-items: center">
                <div style="width: 60px; height: 60px; flex-shrink: 0; border-radius: 12px; background: #E6E3EB; display: flex; align-items: center; justify-content: center; color: #B9B4C4">
                  <svg width="60" height="60" viewBox="0 0 60 60" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M0 0L60 60M60 0L0 60" /></svg>
                </div>
                <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 6px">
                  <div style="width: 90px; height: 10px; border-radius: 4px; background: #C9C5D2" />
                  <div style="width: 70px; height: 8px; border-radius: 4px; background: #DCD9E2" />
                  <div style="width: 56px; height: 14px; border-radius: 7px; background: #E6E3EB" />
                </div>
                <div style="width: 54px; height: 28px; flex-shrink: 0; border-radius: 8px; border: 1.5px dashed #B9B4C4; box-sizing: border-box" />
              </div>
            ))
          }
        </div>
        <div style="position: absolute; left: 16px; right: 16px; bottom: 64px; height: 60px; border-radius: 16px; border: 1.5px dashed #B9B4C4; box-sizing: border-box; display: flex; align-items: center; justify-content: center; font-family: ui-monospace, monospace; font-size: 11px; color: #8E889B">[ botón pagar ]</div>
        <div style="position: absolute; left: 0px; right: 0px; bottom: 0px; height: 56px; border-top: 1.5px dashed #B9B4C4; display: flex; justify-content: space-around; align-items: center">
          {[1, 2, 3, 4].map(() => <div style="width: 20px; height: 20px; border-radius: 6px; background: #DCD9E2" />)}
        </div>
      </div>

      <div data-show="1" style={scr + "background:#FFFFFF;"}>
        <div style="display: flex; justify-content: space-between; align-items: center">
          <div>
            <div style="font-size: 12px; color: #6A6478">Hola, Sofía</div>
            <div style="font-size: 19px; font-weight: 700; letter-spacing: -0.01em">Reservá tu clase</div>
          </div>
          <div style="width: 36px; height: 36px; border-radius: 50%; background: #EFE6FC; color: #4E28B8; font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center">SF</div>
        </div>
        <div style="display: flex; gap: 8px; margin-top: 16px">
          {
            days.map(([d, n]) =>
              d === "Mar" ? (
                <div style="flex-grow: 1; height: 60px; border-radius: 14px; background: #6C3CE0; color: #FFFFFF; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 8px 18px -8px rgba(108,60,224,0.8)">
                  <span style="font-size: 11px; opacity: 0.85">{d}</span>
                  <span style="font-size: 17px; font-weight: 700">{n}</span>
                </div>
              ) : (
                <div style="flex-grow: 1; height: 60px; border-radius: 14px; background: #F6F3FB; display: flex; flex-direction: column; align-items: center; justify-content: center">
                  <span style="font-size: 11px; color: #6A6478">{d}</span>
                  <span style="font-size: 17px; font-weight: 700">{n}</span>
                </div>
              )
            )
          }
        </div>
        <div style="margin-top: 18px; font-size: 13px; font-weight: 700">Hoy en Estudio Alma</div>
        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 10px">
          {
            clases.map((c) => (
              <div style="height: 80px; box-sizing: border-box; border-radius: 16px; border: 1px solid #ECE8F3; background: #FFFFFF; padding: 8px; display: flex; gap: 10px; align-items: center; box-shadow: 0 6px 16px -10px rgba(108,60,224,0.3)">
                <div style={c.fotoSt}>
                  <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="5" r="2.2" />
                    <path d="M5 11l7-2 7 2M12 9v6l-4 5M12 15l4 5" />
                  </svg>
                </div>
                <div style="flex-grow: 1; display: flex; flex-direction: column; gap: 3px; min-width: 0">
                  <div style="font-size: 12px; font-weight: 700">{c.nombre}</div>
                  <div style="font-size: 12px; color: #6A6478">{c.hora}</div>
                  <div style={c.pillSt}>{c.cupo}</div>
                </div>
                <span style={c.btnSt}>{c.btn}</span>
              </div>
            ))
          }
        </div>
        <div style="position: absolute; left: 16px; right: 16px; bottom: 64px; height: 60px; box-sizing: border-box; border-radius: 16px; background: #15121F; padding: 0 10px 0 14px; display: flex; align-items: center; justify-content: space-between">
          <div>
            <div style="font-size: 11px; color: #B3ADC4">Pack 8 clases</div>
            <div style="font-size: 16px; font-weight: 700; color: #FFFFFF">$38.800</div>
          </div>
          <span style="border-radius: 10px; background: #FFFFFF; color: #171225; font-size: 11px; font-weight: 700; padding: 10px 10px">Pagar con Mercado Pago</span>
        </div>
        <div style="position: absolute; left: 0px; right: 0px; bottom: 0px; height: 56px; border-top: 1px solid #EEEBF3; background: #FFFFFF; display: flex; justify-content: space-around; align-items: center; font-size: 10px; color: #6A6478">
          <div style="display: flex; flex-direction: column; align-items: center; gap: 2px; color: #6C3CE0; font-weight: 700">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11l8-7 8 7v9H4z" /></svg>Inicio
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: 2px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M4 10h16M9 3v4M15 3v4" /></svg>Clases
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: 2px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2" /><circle cx="12" cy="12" r="2.5" /></svg>Pagos
          </div>
          <div style="display: flex; flex-direction: column; align-items: center; gap: 2px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1-4 4-6 8-6s7 2 8 6" /></svg>Perfil
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    data-show="1"
    style="position:absolute; left:0; top:176px; width:236px; box-sizing:border-box; padding:12px 14px; background:#FFFFFF; border-radius:18px; box-shadow:0 18px 40px -16px rgba(108,60,224,.45), 0 2px 6px rgba(23,18,37,.08); display:flex; gap:10px; align-items:center; z-index:6; --from:translateX(-16px); --delay:350ms;"
  >
    <div style="width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: #EFE6FC; color: #6C3CE0; display: flex; align-items: center; justify-content: center">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </div>
    <div style="flex-grow: 1">
      <div style="font-size: 13px; font-weight: 700">Turno confirmado</div>
      <div style="font-size: 12px; color: #6A6478">Pilates · mar 13, 18:00</div>
    </div>
    <div style="font-size: 11px; color: #6A6478; align-self: flex-start">ahora</div>
  </div>

  <Legend steps={["Boceto", "App"]} style="left: 0px; right: 0px; top: 646px;" />
</div>
