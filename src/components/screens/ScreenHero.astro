---
// Pantalla del hero: compu + tablet + celu, con tres notificaciones que entran
// en cascada apenas carga la página.
const pill = "padding:2px 8px; border-radius:999px; font-size:10px; font-weight:700;";
const filas = [
  { c: "Marcela Gómez", p: "Torta 2 kg", e: "Pagado", st: pill + "background:#E3F7EA; color:#146C3A;" },
  { c: "Juan Pérez", p: "Docena alfajores", e: "Seña", st: pill + "background:#FFF1D6; color:#7A4E00;" },
  { c: "Lucía Fernández", p: "Torta 1 kg", e: "En preparación", st: pill + "background:#EFE6FC; color:#4E28B8;" },
  { c: "Martín Díaz", p: "Box desayuno", e: "Nuevo", st: pill + "background:#E0EEFF; color:#1F4E9A;" },
];
const notif =
  "position:absolute; box-sizing:border-box; padding:10px 16px 10px 10px; background:#FFFFFF; border-radius:18px; box-shadow:0 18px 40px -16px rgba(108,60,224,.5), 0 2px 6px rgba(23,18,37,.08); display:flex; gap:10px; align-items:center; z-index:6; white-space:nowrap; --dur:600ms;";
const bars = [18, 26, 22, 34, 38, 44];
---

<div class="scr" data-steps="2" data-trigger="load" data-estado="0" style="position: relative; width: 720px; height: 600px; color: #171225">
  <div style="position: absolute; left: 80px; top: 0px; width: 600px; height: 380px; box-sizing: border-box; padding: 10px; background: #15121F; border-radius: 18px 18px 8px 8px; box-shadow: 0 50px 90px -50px rgba(108,60,224,0.6)">
    <div style="width: 580px; height: 360px; border-radius: 9px; overflow: hidden; background: #FAF9FC; display: flex">
      <div style="width: 118px; flex-shrink: 0; box-sizing: border-box; padding: 14px 10px; background: #15121F; color: #B3ADC4; display: flex; flex-direction: column; gap: 2px; font-size: 11px">
        <div style="display: flex; align-items: center; gap: 6px; color: #FFFFFF; font-size: 12px; font-weight: 700; margin-bottom: 12px"><div style="width: 18px; height: 18px; border-radius: 6px; background: #F3B7C8"></div>Dulce Nube</div>
        <div style="padding: 7px 8px; border-radius: 7px; background: rgba(255,255,255,0.08); color: #FFFFFF; font-weight: 600">Hoy</div>
        <div style="padding: 7px 8px">Clientes</div>
        <div style="padding: 7px 8px">Pedidos</div>
        <div style="padding: 7px 8px">Cobros</div>
      </div>
      <div style="flex-grow: 1; box-sizing: border-box; padding: 14px 16px; display: flex; flex-direction: column; gap: 10px">
        <div style="font-size: 15px; font-weight: 700">Hoy, martes 13</div>
        <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px">
          <div style="background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 10px; padding: 8px 10px"><div style="font-size: 10px; color: #6A6478">Consultas</div><div style="font-size: 17px; font-weight: 800">12</div></div>
          <div style="background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 10px; padding: 8px 10px"><div style="font-size: 10px; color: #6A6478">Pedidos</div><div style="font-size: 17px; font-weight: 800">7</div></div>
          <div style="background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 10px; padding: 8px 10px"><div style="font-size: 10px; color: #6A6478">Cobrado</div><div style="font-size: 17px; font-weight: 800">$86.400</div></div>
        </div>
        <div style="background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 10px; overflow: hidden">
          {
            filas.map((f) => (
              <div style="display: flex; align-items: center; justify-content: space-between; height: 34px; padding: 0 12px; font-size: 11px; border-bottom: 1px solid #F4F2F7">
                <span style="font-weight: 600; width: 110px">{f.c}</span>
                <span style="color: #4A4458; flex-grow: 1">{f.p}</span>
                <span style={f.st}>{f.e}</span>
              </div>
            ))
          }
        </div>
        <div style="display: flex; align-items: flex-end; gap: 6px; height: 50px; padding: 0 2px">
          {bars.map((h) => <div style={`flex-grow: 1; height: ${h}px; border-radius: 4px; background: #E4DAF8`} />)}
          <div style="flex-grow: 1; height: 50px; border-radius: 4px; background: #6C3CE0"></div>
        </div>
      </div>
    </div>
  </div>
  <div style="position: absolute; left: 60px; top: 380px; width: 640px; height: 14px; border-radius: 0 0 14px 14px; background: #2A2536; display: flex; justify-content: center"><div style="width: 100px; height: 5px; border-radius: 0 0 8px 8px; background: #15121F"></div></div>

  <div style="position: absolute; left: 0px; top: 250px; width: 320px; height: 230px; box-sizing: border-box; padding: 11px; background: #15121F; border-radius: 26px; box-shadow: 0 40px 70px -36px rgba(108,60,224,0.6), 0 4px 12px rgba(23,18,37,0.14); z-index: 2">
    <div style="width: 298px; height: 208px; border-radius: 16px; overflow: hidden; background: #FFFDF8">
      <div style="height: 32px; box-sizing: border-box; padding: 0 10px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #EDE6DA">
        <span style="font-size: 12px; font-weight: 800; color: #0F6E63">San Roque</span>
        <span style="padding: 4px 8px; border-radius: 6px; background: #0F6E63; color: #FFFFFF; font-size: 9px; font-weight: 700">Pedir turno</span>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 12px 10px">
        <div style="display: flex; flex-direction: column; gap: 6px">
          <div style="font-size: 15px; line-height: 1.1; font-weight: 800; color: #10312D">Cuidamos a tu mascota, también de noche.</div>
          <div style="font-size: 9px; color: #4A4458">Guardia 24 h en Caballito.</div>
          <span style="align-self: flex-start; padding: 5px 8px; border-radius: 7px; background: #25D366; color: #171225; font-size: 9px; font-weight: 700">Consultar por WhatsApp</span>
        </div>
        <div style="height: 120px; border-radius: 12px; background: #D7EDE8; display: flex; align-items: center; justify-content: center">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="#0F6E63" aria-hidden="true"><circle cx="7" cy="9" r="2"></circle><circle cx="17" cy="9" r="2"></circle><circle cx="10" cy="5.5" r="2"></circle><circle cx="14" cy="5.5" r="2"></circle><path d="M12 11c-3 0-5.5 3.5-5.5 6 0 1.5 1.2 2.5 2.6 2.5 1.2 0 1.8-.6 2.9-.6s1.7.6 2.9.6c1.4 0 2.6-1 2.6-2.5 0-2.5-2.5-6-5.5-6z"></path></svg>
        </div>
      </div>
    </div>
  </div>

  <div style="position: absolute; left: 520px; top: 170px; width: 190px; height: 390px; box-sizing: border-box; padding: 8px; background: #15121F; border-radius: 34px; box-shadow: 0 40px 70px -36px rgba(108,60,224,0.6), 0 4px 12px rgba(23,18,37,0.14); z-index: 3">
    <div style="position: relative; width: 174px; height: 374px; border-radius: 27px; overflow: hidden; background: #FFFFFF; box-sizing: border-box; padding: 34px 11px 0">
      <div style="position: absolute; top: 8px; left: 57px; width: 60px; height: 17px; border-radius: 999px; background: #15121F"></div>
      <div style="font-size: 10px; color: #6A6478">Hola, Sofía</div>
      <div style="font-size: 14px; font-weight: 800">Reservá tu clase</div>
      <div style="display: flex; gap: 5px; margin-top: 10px">
        <div style="flex-grow: 1; height: 42px; border-radius: 10px; background: #F6F3FB; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 12px; font-weight: 700"><span style="font-size: 8px; font-weight: 500; color: #6A6478">Lun</span>12</div>
        <div style="flex-grow: 1; height: 42px; border-radius: 10px; background: #6C3CE0; color: #FFFFFF; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 12px; font-weight: 700"><span style="font-size: 8px; font-weight: 500">Mar</span>13</div>
        <div style="flex-grow: 1; height: 42px; border-radius: 10px; background: #F6F3FB; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 12px; font-weight: 700"><span style="font-size: 8px; font-weight: 500; color: #6A6478">Mié</span>14</div>
      </div>
      <div style="display: flex; flex-direction: column; gap: 6px; margin-top: 10px">
        <div style="display: flex; gap: 8px; align-items: center; padding: 6px; border-radius: 12px; border: 1px solid #ECE8F3">
          <div style="width: 38px; height: 38px; border-radius: 9px; background: #E4D8FB"></div>
          <div style="flex-grow: 1"><div style="font-size: 10px; font-weight: 700">Pilates reformer</div><div style="font-size: 9px; color: #6A6478">18:00 · Caro</div></div>
        </div>
        <div style="display: flex; gap: 8px; align-items: center; padding: 6px; border-radius: 12px; border: 1px solid #ECE8F3">
          <div style="width: 38px; height: 38px; border-radius: 9px; background: #FDE3C8"></div>
          <div style="flex-grow: 1"><div style="font-size: 10px; font-weight: 700">Yoga suave</div><div style="font-size: 9px; color: #6A6478">19:30 · Martín</div></div>
        </div>
        <div style="display: flex; gap: 8px; align-items: center; padding: 6px; border-radius: 12px; border: 1px solid #ECE8F3">
          <div style="width: 38px; height: 38px; border-radius: 9px; background: #D6F0E0"></div>
          <div style="flex-grow: 1"><div style="font-size: 10px; font-weight: 700">Funcional</div><div style="font-size: 9px; color: #6A6478">20:30 · Juli</div></div>
        </div>
      </div>
      <div style="position: absolute; left: 11px; right: 11px; bottom: 14px; height: 36px; border-radius: 11px; background: #15121F; color: #FFFFFF; font-size: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center">Pagar con Mercado Pago</div>
    </div>
  </div>

  <div data-show="1" style={notif + "left:430px; top:36px; --from:translateY(-12px); --delay:200ms;"}>
    <div style="width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: #25D366; color: #171225; display: flex; align-items: center; justify-content: center">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg>
    </div>
    <div style="font-size: 13px; font-weight: 700">Nueva consulta <span style="font-weight: 500; color: #6A6478">· hace 1 min</span></div>
  </div>
  <div data-show="1" style={notif + "left:230px; top:196px; --from:translateX(-16px); --delay:900ms;"}>
    <div style="width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: #EFE6FC; color: #6C3CE0; display: flex; align-items: center; justify-content: center">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5M10 13h6M10 17h6"></path></svg>
    </div>
    <div style="font-size: 13px; font-weight: 700">Reporte listo <span style="font-weight: 500; color: #6A6478">· 8:00</span></div>
  </div>
  <div data-show="1" style={notif + "left:300px; top:500px; --from:translateY(12px); --delay:1600ms;"}>
    <div style="width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: #15121F; color: #FFFFFF; display: flex; align-items: center; justify-content: center">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="2"></rect><circle cx="12" cy="12" r="2.5"></circle></svg>
    </div>
    <div style="font-size: 13px; font-weight: 700">Pago recibido <span style="font-weight: 500; color: #6A6478">· $38.800</span></div>
  </div>

  <div style="position: absolute; left: 0px; right: 0px; top: 578px; text-align: center; font-size: 12px; font-weight: 500; color: #6A6478">Ejemplo ilustrativo</div>
</div>
