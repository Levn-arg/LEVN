---
import Legend from "./Legend.astro";

// Automatización: Excel cargado a mano → flujo automatizado → sistema de gestión.
const cell = "height:30px; box-sizing:border-box; padding:0 8px; border-right:1px solid #E5E2EA; border-bottom:1px solid #E5E2EA; display:flex; align-items:center; white-space:nowrap; overflow:hidden; font-size:12px;";
const kinds: Record<string, string> = {
  h: cell + "background:#F4F3F6; color:#6A6478; font-size:11px; justify-content:center;",
  n: cell + "background:#F4F3F6; color:#6A6478; font-size:11px; justify-content:center;",
  b: cell + "font-weight:700;",
  x: cell,
  d: cell + "background:#FFF4C2;",
  e: cell + "background:#FDE8E8; color:#B42318; font-weight:700;",
};
const rows: [string, string[], number?][] = [
  ["h", ["", "A", "B", "C", "D", "E", "F"]],
  ["b", ["1", "Fecha", "Cliente", "Teléfono", "Pedido", "Monto", "Estado"]],
  ["x", ["2", "03/03", "Marcela Gómez", "11 5555-2211", "Torta 2 kg", "$38.800", "pagado"]],
  ["d", ["3", "3-mar", "marcela gomez", "1155552211", "torta 2kg", "38800", "PAGADO??"]],
  ["x", ["4", "04/03", "Juan Pérez", "", "Docena alfajores", "#¡VALOR!", "pendiente"], 5],
  ["x", ["5", "05/03", "Lucía Fernández", "11 4433-9087", "Torta 1 kg", "$21.500", "ver con Lu"]],
  ["x", ["6", "06/03", "???", "11 6021-3344", "Cheesecake", "$24.300", ""]],
  ["x", ["7", "07/03", "Martín Díaz", "11 2987-1120", "Box desayuno", "#¡REF!", "pendiente"], 5],
  ["b", ["8", "", "", "", "TOTAL", "#¡VALOR!", ""], 5],
  ["x", ["9", "", "", "", "", "", ""]],
];
const xl = rows.map(([k, cells, errCol]) =>
  cells.map((t, i) => ({ t, st: i === 0 ? kinds.n : k === "h" ? kinds.h : i === errCol ? kinds.e : kinds[k] }))
);
const ico = "width:34px; height:34px; border-radius:10px; display:flex; align-items:center; justify-content:center;";
const nodos = [
  { t: "Formulario", s: "Pedido desde la web", d: "M6 3h12v18H6zM9 8h6M9 12h6M9 16h3", icoSt: ico + "background:#EFE6FC; color:#6C3CE0;" },
  { t: "Planilla", s: "Fila agregada sola", d: "M3 4h18v16H3zM3 10h18M3 15h18M10 4v16", icoSt: ico + "background:#E3F7EA; color:#146C3A;" },
  { t: "WhatsApp", s: "Confirmación enviada", d: "M4 5h16v11H9l-5 4z", icoSt: ico + "background:#25D366; color:#171225;" },
  { t: "Facturación", s: "Factura C emitida", d: "M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6", icoSt: ico + "background:#FDEBD3; color:#8A4500;" },
];
const logs = [
  { h: "10:42", n: "Marcela Gómez · Torta 2 kg" },
  { h: "10:15", n: "Lucía Fernández · Torta 1 kg" },
  { h: "09:58", n: "Martín Díaz · Box desayuno" },
];
const pill = "display:inline-block; padding:2px 8px; border-radius:999px; font-size:10px; font-weight:700;";
const crm = [
  { c: "Marcela Gómez", p: "Torta 2 kg", m: "$38.800", e: "Pagado", st: pill + "background:#E3F7EA; color:#146C3A;" },
  { c: "Juan Pérez", p: "Docena alfajores", m: "$14.200", e: "Seña", st: pill + "background:#FFF1D6; color:#7A4E00;" },
  { c: "Lucía Fernández", p: "Torta 1 kg", m: "$21.500", e: "En preparación", st: pill + "background:#EFE6FC; color:#4E28B8;" },
  { c: "Martín Díaz", p: "Box desayuno", m: "$27.600", e: "Nuevo", st: pill + "background:#E0EEFF; color:#1F4E9A;" },
];
const notif = "position:absolute; width:250px; box-sizing:border-box; padding:12px 14px; background:#FFFFFF; border-radius:18px; box-shadow:0 18px 40px -16px rgba(108,60,224,.45), 0 2px 6px rgba(23,18,37,.08); display:flex; gap:10px; align-items:center; z-index:6; --delay:350ms;";
const scr = "position:absolute; inset:0;";
const miniBars = [6, 9, 8, 12, 14];
---

<div class="scr" data-steps="3" data-estado="0" style="position: relative; width: 820px; height: 580px; color: #171225">
  <div style="position: absolute; left: 30px; top: 0px; width: 760px; height: 470px; box-sizing: border-box; padding: 10px; background: #15121F; border-radius: 20px 20px 8px 8px; box-shadow: 0 50px 90px -50px rgba(108,60,224,0.55)">
    <div style="position: relative; width: 740px; height: 450px; border-radius: 10px; overflow: hidden; background: #FFFFFF">
      <div data-show="0" style={scr + "background:#FFFFFF;"}>
        <div style="height: 34px; box-sizing: border-box; padding: 0 12px; background: #F4F3F6; border-bottom: 1px solid #E5E2EA; display: flex; align-items: center; gap: 10px">
          <div style="display: flex; gap: 5px"><div style="width: 10px; height: 10px; border-radius: 50%; background: #DDD9E3"></div><div style="width: 10px; height: 10px; border-radius: 50%; background: #DDD9E3"></div><div style="width: 10px; height: 10px; border-radius: 50%; background: #DDD9E3"></div></div>
          <div style="width: 18px; height: 18px; border-radius: 4px; background: #2F7A4F; color: #FFFFFF; font-size: 10px; font-weight: 800; display: flex; align-items: center; justify-content: center">X</div>
          <div style="font-size: 12px; font-weight: 700">clientes_marzo_FINAL (3).xlsx</div>
          <div style="margin-left: auto; font-size: 11px; color: #6A6478">Cargado a mano · editado hace 2 h</div>
        </div>
        <div style="height: 28px; box-sizing: border-box; padding: 0 10px; border-bottom: 1px solid #E5E2EA; display: flex; align-items: center; gap: 10px; font-family: ui-monospace, monospace; font-size: 11px; color: #4A4458">
          <div style="padding: 2px 8px; border: 1px solid #E5E2EA; border-radius: 4px">F8</div>
          <div style="font-style: italic; color: #6A6478">fx</div>
          <div>=SUMA(F2:F7)/C4</div>
        </div>
        {
          xl.map((cells) => (
            <div style="display: grid; grid-template-columns: 32px 70px 140px 118px 140px 110px 130px">
              {cells.map((c) => <div style={c.st}>{c.t}</div>)}
            </div>
          ))
        }
        <div style="position: absolute; left: 520px; top: 150px; width: 170px; box-sizing: border-box; padding: 8px 10px; background: #FFF4C2; border: 1px solid #EAD98A; border-radius: 8px; font-size: 11px; line-height: 1.35; color: #5C4B00; box-shadow: 0 6px 14px -8px rgba(23,18,37,0.35)">¿Quién cargó esto? Revisar antes del cierre. — Ana</div>
        <div style="position: absolute; left: 0px; right: 0px; bottom: 0px; height: 30px; box-sizing: border-box; background: #F4F3F6; border-top: 1px solid #E5E2EA; display: flex; align-items: center; gap: 2px; padding: 0 8px; font-size: 11px; color: #4A4458">
          <div style="padding: 5px 12px; background: #FFFFFF; border-radius: 4px; font-weight: 700">Hoja1</div>
          <div style="padding: 5px 12px">Hoja1 (2)</div>
          <div style="padding: 5px 12px">NO TOCAR</div>
          <div style="padding: 5px 12px">copia vieja</div>
        </div>
      </div>

      <div data-show="1" style={scr + "background-color:#FAF8FE; background-image:radial-gradient(#E3DCF3 1px, transparent 1.2px); background-size:16px 16px;"}>
        <div style="height: 44px; box-sizing: border-box; padding: 0 16px; background: #FFFFFF; border-bottom: 1px solid #ECE8F3; display: flex; align-items: center; gap: 10px">
          <div style="font-size: 13px; font-weight: 700">Flujo · Pedido nuevo</div>
          <div style="margin-left: auto; font-size: 11px; color: #6A6478">Última ejecución: hace 2 min</div>
          <div style="display: flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; background: #E3F7EA; color: #146C3A; font-size: 11px; font-weight: 700"><div style="width: 7px; height: 7px; border-radius: 50%; background: #1FA855"></div>Activo</div>
        </div>
        <div style="display: flex; align-items: center; justify-content: center; margin-top: 36px">
          {
            nodos.map((n, i) => (
              <>
                {i > 0 && (
                  <svg width="36" height="14" viewBox="0 0 36 14" fill="none" stroke="#6C3CE0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 7h30M27 2l5 5-5 5" />
                  </svg>
                )}
                <div style="width: 136px; box-sizing: border-box; padding: 12px; background: #FFFFFF; border: 1px solid #E7E2F2; border-radius: 16px; box-shadow: 0 12px 24px -16px rgba(108,60,224,0.45)">
                  <div style={n.icoSt}>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d={n.d} />
                    </svg>
                  </div>
                  <div style="font-size: 13px; font-weight: 700; margin-top: 10px">{n.t}</div>
                  <div style="font-size: 11px; color: #6A6478; margin-top: 2px">{n.s}</div>
                  <div style="display: inline-flex; align-items: center; gap: 4px; margin-top: 10px; padding: 2px 8px; border-radius: 999px; background: #E3F7EA; color: #146C3A; font-size: 10px; font-weight: 700">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12.5l4.5 4.5L19 7.5" />
                    </svg>
                    OK
                  </div>
                </div>
              </>
            ))
          }
        </div>
        <div style="margin: 30px 44px 0; background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 16px; overflow: hidden">
          <div style="height: 36px; padding: 0 14px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #F1EEF6; font-size: 12px; font-weight: 700; color: #4A4458"><span>Hoy</span><span style="font-weight: 500; color: #6A6478">Sin cargar nada a mano</span></div>
          {
            logs.map((g) => (
              <div style="height: 40px; padding: 0 14px; display: flex; align-items: center; gap: 12px; border-bottom: 1px solid #F6F4F9; font-size: 12px">
                <span style="font-family: ui-monospace, monospace; font-size: 11px; color: #6A6478; width: 38px">{g.h}</span>
                <span style="flex-grow: 1; font-weight: 600">{g.n}</span>
                <span style="padding: 2px 8px; border-radius: 999px; background: #F1EEF6; color: #4A4458; font-size: 10px; font-weight: 700">Planilla ✓</span>
                <span style="padding: 2px 8px; border-radius: 999px; background: #DDF8E7; color: #146C3A; font-size: 10px; font-weight: 700">WhatsApp ✓</span>
                <span style="padding: 2px 8px; border-radius: 999px; background: #FDEBD3; color: #8A4500; font-size: 10px; font-weight: 700">Factura ✓</span>
              </div>
            ))
          }
        </div>
      </div>

      <div data-show="2" style={scr + "display:flex;"}>
        <div style="width: 150px; flex-shrink: 0; box-sizing: border-box; padding: 16px 12px; background: #15121F; color: #B3ADC4; display: flex; flex-direction: column; gap: 4px; font-size: 12px">
          <div style="display: flex; align-items: center; gap: 8px; color: #FFFFFF; font-size: 14px; font-weight: 700; margin-bottom: 14px"><div style="width: 22px; height: 22px; border-radius: 7px; background: #F3B7C8"></div>Dulce Nube</div>
          <div style="padding: 8px 10px; border-radius: 8px; background: rgba(255,255,255,0.08); color: #FFFFFF; font-weight: 600">Inicio</div>
          <div style="padding: 8px 10px">Clientes</div>
          <div style="padding: 8px 10px">Pedidos</div>
          <div style="padding: 8px 10px">Cobros</div>
          <div style="padding: 8px 10px">Reportes</div>
        </div>
        <div style="flex-grow: 1; box-sizing: border-box; padding: 18px; background: #FAF9FC; display: flex; flex-direction: column; gap: 10px">
          <div style="display: flex; align-items: center; justify-content: space-between">
            <div><div style="font-size: 16px; font-weight: 700">Marzo 2026</div><div style="font-size: 11px; color: #6A6478">Hola, Ana</div></div>
            <div style="position: relative; color: #4A4458">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"></path><path d="M10 21h4"></path></svg>
              <div style="position: absolute; top: 0px; right: 0px; width: 8px; height: 8px; border-radius: 50%; background: #6C3CE0"></div>
            </div>
          </div>
          <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px">
            <div style="background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 12px; padding: 10px 12px">
              <div style="font-size: 10px; color: #6A6478">Ventas del mes</div>
              <div style="font-size: 17px; font-weight: 800; margin-top: 2px">$2.184.600</div>
              <div style="display: flex; align-items: flex-end; gap: 3px; height: 18px; margin-top: 6px">
                {miniBars.map((h) => <div style={`width: 8px; height: ${h}px; border-radius: 2px; background: #D9CCF7`} />)}
                <div style="width: 8px; height: 18px; border-radius: 2px; background: #6C3CE0"></div>
              </div>
            </div>
            <div style="background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 12px; padding: 10px 12px"><div style="font-size: 10px; color: #6A6478">Pedidos</div><div style="font-size: 17px; font-weight: 800; margin-top: 2px">96</div><div style="font-size: 10px; color: #6A6478; margin-top: 8px">14 esta semana</div></div>
            <div style="background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 12px; padding: 10px 12px"><div style="font-size: 10px; color: #6A6478">Por cobrar</div><div style="font-size: 17px; font-weight: 800; margin-top: 2px">$214.000</div><div style="font-size: 10px; color: #6A6478; margin-top: 8px">5 clientes</div></div>
          </div>
          <div style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 10px; background: #EFE6FC; color: #4E28B8; font-size: 12px; font-weight: 600">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"></path><path d="M10 21h4"></path></svg>
            3 pedidos se entregan mañana<span style="margin-left: auto; text-decoration: underline">Ver lista</span>
          </div>
          <div style="background: #FFFFFF; border: 1px solid #ECE8F3; border-radius: 12px; overflow: hidden">
            <div style="display: grid; grid-template-columns: 1.3fr 1.3fr 1fr 1.1fr; padding: 8px 12px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #6A6478; border-bottom: 1px solid #F1EEF6"><span>Cliente</span><span>Último pedido</span><span>Monto</span><span>Estado</span></div>
            {
              crm.map((k) => (
                <div style="display: grid; grid-template-columns: 1.3fr 1.3fr 1fr 1.1fr; align-items: center; height: 34px; padding: 0 12px; font-size: 12px; border-bottom: 1px solid #F6F4F9">
                  <span style="font-weight: 600">{k.c}</span>
                  <span style="color: #4A4458">{k.p}</span>
                  <span>{k.m}</span>
                  <span><span style={k.st}>{k.e}</span></span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
  <div style="position: absolute; left: 0px; top: 470px; width: 820px; height: 16px; border-radius: 0 0 16px 16px; background: #2A2536; display: flex; justify-content: center"><div style="width: 120px; height: 6px; border-radius: 0 0 8px 8px; background: #15121F"></div></div>

  <div data-show="1" style={notif + "right:0; top:56px; --from:translateX(16px);"}>
    <div style="width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: #25D366; color: #171225; display: flex; align-items: center; justify-content: center">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"></path></svg>
    </div>
    <div style="flex-grow: 1"><div style="font-size: 13px; font-weight: 700">Mensaje enviado a Marcela</div><div style="font-size: 12px; color: #6A6478">Confirmación de pedido</div></div>
    <div style="font-size: 11px; color: #6A6478; align-self: flex-start">ahora</div>
  </div>
  <div data-show="2" style={notif + "left:0; top:300px; --from:translateX(-16px);"}>
    <div style="width: 32px; height: 32px; flex-shrink: 0; border-radius: 50%; background: #EFE6FC; color: #6C3CE0; display: flex; align-items: center; justify-content: center">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5M10 13h6M10 17h6"></path></svg>
    </div>
    <div style="flex-grow: 1"><div style="font-size: 13px; font-weight: 700">Reporte listo · 8:00</div><div style="font-size: 12px; color: #6A6478">Ventas de ayer: $86.400</div></div>
  </div>

  <Legend steps={["Excel", "Automatización", "Sistema"]} style="left: 0px; right: 0px; top: 506px;" />
  <div style="position: absolute; left: 0px; right: 0px; top: 558px; text-align: center; font-size: 12px; font-weight: 500; color: #6A6478">Ejemplo ilustrativo</div>
</div>
