---
const stats = [
  { value: "+12", label: "negocios diagnosticados" },
  { value: "68%", label: "mejora promedio en conversión" },
  { value: "120h", label: "ahorradas al mes en tareas" },
  { value: "+38%", label: "crecimiento promedio en ventas" },
];
---

<section class="pt-10 px-12 max-[900px]:px-6" data-reveal>
  <div
    class="grid grid-cols-4 rounded-[22px] bg-white px-2.5 py-7.5 text-center max-[900px]:grid-cols-2 max-[900px]:gap-y-6"
  >
    {
      stats.map((stat) => (
        <div>
          <p class="text-[26px] font-extrabold text-accent">{stat.value}</p>
          <p class="mt-1 text-[12.5px] text-muted-2">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>
