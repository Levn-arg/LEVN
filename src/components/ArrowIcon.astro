---
// Flecha de los CTAs. `down` para los links que bajan en la página.
interface Props {
  size?: number;
  down?: boolean;
  class?: string;
}

const { size = 20, down = false, class: className } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={className}>
  <path d={down ? "M12 5v14M6 13l6 6 6-6" : "M5 12h14M13 6l6 6-6 6"}></path>
</svg>
