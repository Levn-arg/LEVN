---
import ArrowIcon from "./ArrowIcon.astro";
import PainCard from "./screens/PainCard.astro";

const tipos = [1, 2, 3, 4] as const;
---

<section
  id="dolor"
  class="mx-auto flex max-w-360 flex-col items-center gap-13 px-21 py-24 max-[1100px]:px-10 max-[900px]:items-stretch max-[900px]:gap-7 max-[900px]:px-4 max-[900px]:py-14"
>
  <h2 class="m-0 text-center text-[52px] leading-[1.05] font-extrabold tracking-[-0.03em] max-[900px]:text-left max-[900px]:text-[34px] max-[900px]:leading-[1.06]">
    ¿Cuál de estas te está pasando?
  </h2>
  <div
    data-pain-track
    class="no-scrollbar flex flex-wrap justify-center gap-6 max-[900px]:-mx-4 max-[900px]:snap-x max-[900px]:snap-mandatory max-[900px]:flex-nowrap max-[900px]:justify-start max-[900px]:gap-3.5 max-[900px]:overflow-x-auto max-[900px]:px-4 max-[900px]:pt-1 max-[900px]:pb-6"
  >
    {
      tipos.map((tipo) => (
        <div class="flex-none snap-start max-[900px]:last:pr-4">
          <PainCard tipo={tipo} />
        </div>
      ))
    }
  </div>
  <div class="-mt-3 hidden justify-center gap-1.5 max-[900px]:flex" aria-hidden="true">
    {tipos.map((_, i) => <span data-pain-dot class:list={["h-1.5 rounded-[3px] transition-all duration-300", i === 0 ? "w-5 bg-accent" : "w-1.5 bg-[#D9CCF7]"]} />)}
  </div>
  <p class="m-0 flex items-center gap-2.5 text-xl font-semibold text-muted max-[900px]:gap-2 max-[900px]:text-[17px]">
    Si te reconociste en alguna, seguí bajando.
    <ArrowIcon size={20} down class="text-accent" />
  </p>
</section>

<script>
  // Marca en los puntitos la tarjeta visible del carrusel (mobile).
  const track = document.querySelector<HTMLElement>("[data-pain-track]");
  const dots = document.querySelectorAll<HTMLElement>("[data-pain-dot]");

  track?.addEventListener(
    "scroll",
    () => {
      const card = track.firstElementChild as HTMLElement | null;
      if (!card) return;
      const index = Math.round(track.scrollLeft / (card.offsetWidth + 14));
      dots.forEach((dot, i) => {
        const active = i === Math.min(index, dots.length - 1);
        dot.classList.toggle("w-5", active);
        dot.classList.toggle("bg-accent", active);
        dot.classList.toggle("w-1.5", !active);
        dot.classList.toggle("bg-[#D9CCF7]", !active);
      });
    },
    { passive: true }
  );
</script>
