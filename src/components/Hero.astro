---
import ImpactCarousel from "./ImpactCarousel.tsx";
---

<section class="flex items-start gap-10 pt-14 px-12 pb-10 max-[900px]:flex-col max-[900px]:px-6 max-[900px]:pt-10 max-[900px]:pb-8">
  <div class="flex-none w-110 max-[900px]:w-full">
    <p class="mb-3.5 flex items-center gap-2 text-[12px] font-bold tracking-[1px] text-accent">
      <span
        class="flex h-5 w-5 items-center justify-center rounded-full bg-ink text-[10px] text-white"
        >01</span
      >
      SOLUCIONES DIGITALES PARA PYMES ✦
    </p>
    <h1 class="mb-5 text-[52px] font-extrabold leading-[1.05] max-[480px]:text-[34px] max-[900px]:text-[40px]">
      Menos caos.<br />
      <span class="text-accent">Más clientes.</span>
    </h1>
    <p class="mb-6.5 max-w-95 text-base leading-[1.6] text-muted">
      Automatizamos, construimos y hacemos crecer tu negocio con soluciones
      que generan resultados.
    </p>
    <div class="mb-7 flex flex-wrap gap-3">
      <a
        href="#contacto"
        class="inline-flex items-center gap-1.5 rounded-full bg-accent px-5.5 py-3.5 text-sm font-bold text-white hover:bg-accent-hover hover:text-white"
        >Pedí tu diagnóstico gratis <span aria-hidden="true">→</span></a
      >
      <a
        href="#servicios"
        class="inline-flex items-center gap-1.5 rounded-full border-[1.5px] border-ink px-5.5 py-3.5 text-sm font-bold text-ink hover:bg-ink hover:text-white"
        >Ver qué resolvemos <span aria-hidden="true">↓</span></a
      >
    </div>
    <div class="flex items-center gap-3">
      <div class="flex" aria-hidden="true">
        <span class="h-8 w-8 -mr-2.5 rounded-full border-2 border-cream bg-[#d9d9d9]"></span>
        <span class="h-8 w-8 -mr-2.5 rounded-full border-2 border-cream bg-[#c7c7c7]"></span>
        <span class="h-8 w-8 rounded-full border-2 border-cream bg-[#b5b5b5]"></span>
      </div>
      <p class="text-[13px] font-semibold leading-[1.3]">
        +12 negocios ya diagnosticados<br />
        <span class="font-medium text-muted-2">y en camino al crecimiento.</span>
      </p>
    </div>
  </div>

  <div class="flex flex-1 items-start justify-end gap-5 pt-2.5 max-[900px]:w-full max-[900px]:justify-start">
    <ImpactCarousel client:load />
  </div>
</section>
