---
import ArrowIcon from "./ArrowIcon.astro";
import ProjectGrid from "./ProjectGrid.astro";
import { projects } from "../data/projects.json";

// En la home van los primeros 5; el resto está en /proyectos.
const HOME_COUNT = 5;
---

<section id="proyectos" class="mx-auto flex max-w-360 flex-col gap-12 px-21 py-20 max-[1100px]:px-10 max-[900px]:gap-7 max-[900px]:px-4 max-[900px]:py-12">
  <div class="flex flex-col gap-4">
    <div class="text-[13px] font-extrabold tracking-widest text-accent uppercase max-[900px]:text-xs">Proyectos</div>
    <h2 class="m-0 text-[52px] leading-[1.05] font-extrabold tracking-[-0.03em] max-[900px]:text-[34px] max-[900px]:leading-[1.06]">Así se ve <span class="text-accent">resuelto.</span></h2>
  </div>

  <ProjectGrid projects={projects.slice(0, HOME_COUNT)} />

  {
    projects.length > HOME_COUNT && (
      <a
        class="btn inline-flex min-h-14 items-center gap-2.5 self-center rounded-2xl bg-accent px-6 text-[17px] font-bold text-white no-underline shadow-[0_16px_32px_-14px_rgba(108,60,224,0.75)] max-[900px]:self-stretch max-[900px]:justify-center"
        href="/proyectos/"
      >
        Ver más proyectos
        <ArrowIcon />
      </a>
    )
  }
</section>
