---
const services = [
  {
    icon: "🤖",
    title: "Automatización e Integración",
    tagline: "Que el negocio funcione solo",
    items: [
      "Agentes IA",
      "Integración entre sistemas",
      "Reactivación de clientes",
      "Turnos y recordatorios",
      "Reportes automáticos",
    ],
  },
  {
    icon: "🌐",
    title: "Presencia Digital",
    tagline: "Que existan y conviertan",
    items: [
      "Landing pages que venden",
      "Sitios web profesionales",
      "Google Business optimizado",
      'Paquete "presencia en 7 días"',
      "Diseño enfocado en conversión",
    ],
  },
  {
    icon: "📊",
    title: "Adquisición y Crecimiento",
    tagline: "Traer clientes",
    items: [
      "Campañas Meta / Google",
      "Email marketing",
      "Captación automatizada",
      "Audiencias y remarketing",
      "Embudos que convierten",
    ],
  },
  {
    icon: "</>",
    title: "Desarrollo a Medida",
    tagline: "Creamos software que se adapta a vos",
    items: [
      "Sistemas y apps a medida",
      "MVPs y prototipos",
      "Paneles y reportes a medida",
      "Extracción y procesamiento de datos"
    ],
  },
];
---

<section class="pt-16 px-12 max-[900px]:px-6" id="servicios" data-reveal>
  <div class="mb-9 flex gap-10 max-[900px]:flex-col max-[900px]:gap-4">
    <div class="flex-none w-95 max-[900px]:w-full">
      <p class="mb-3.5 flex items-center gap-2 text-[12px] font-bold tracking-[1px] text-accent">
        QUÉ HACEMOS
      </p>
      <h2 class="text-[30px] font-extrabold">
        Cuatro áreas, <br />un solo equipo.<br />
      </h2>
    </div>
    <p class="flex-1 pt-8.5 text-base leading-[1.6] text-muted max-[900px]:pt-0">
      No vendemos servicios sueltos.<br />
      Construimos un <u>sistema completo</u> que hace crecer tu negocio de forma
      sostenible.
    </p>
  </div>

  <div class="grid grid-cols-4 gap-5 max-[900px]:grid-cols-2 max-[560px]:grid-cols-1">
    {
      services.map((service) => (
        <div class="rounded-[20px] bg-white px-5.5 py-6.5 shadow-[0_12px_30px_rgba(60,40,110,0.06)]">
          <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-[14px] bg-accent-soft text-xl">
            {service.icon}
          </div>
          <p class="mb-1 text-base font-extrabold">{service.title}</p>
          <p class="mb-3.5 text-[12.5px] font-semibold text-accent">
            {service.tagline}
          </p>
          <ul class="text-[13px] leading-loose text-muted">
            {service.items.map((item) => (
              <li>• {item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
