---
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";

// Estructura de las páginas legales. El contenido de cada sección se completa
// en la página que la usa (slot) o, mientras no esté, queda el aviso de
// "contenido pendiente".
interface Props {
  title: string;
  description: string;
  // Fecha de la última actualización, p. ej. "27 de septiembre de 2026".
  updated?: string;
  sections: string[];
}

const { title, description, updated, sections } = Astro.props;
---

<Layout title={`${title} — Levn`} description={description}>
  <Header />
  <main class="mx-auto flex max-w-225 flex-col gap-10 px-10 pt-8 pb-24 max-[900px]:gap-7 max-[900px]:px-4 max-[900px]:pt-5 max-[900px]:pb-14">
    <div class="flex flex-col gap-4">
      <a href="/" class="inline-flex min-h-11 items-center gap-2 self-start text-[15px] font-bold text-accent no-underline hover:text-accent-hover">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"></path></svg>
        Inicio
      </a>
      <h1 class="m-0 text-[56px] leading-[1.05] font-extrabold tracking-[-0.03em] max-[900px]:text-[40px] max-[900px]:leading-[1.04]">{title}</h1>
      <p class="m-0 text-base text-muted-2">Última actualización: {updated ?? "[fecha]"}</p>
    </div>

    <slot>
      <ol class="m-0 flex list-none flex-col gap-3 p-0">
        {
          sections.map((section, i) => (
            <li class="flex flex-col gap-2 rounded-3xl border border-ink/7 bg-white p-7 max-[900px]:rounded-[20px] max-[900px]:p-5">
              <h2 class="m-0 text-[22px] font-extrabold">
                {i + 1}. {section}
              </h2>
              <p class="m-0 text-[17px] leading-[1.6] text-muted-2 italic">Contenido pendiente.</p>
            </li>
          ))
        }
      </ol>
    </slot>
  </main>
  <Footer />
</Layout>
