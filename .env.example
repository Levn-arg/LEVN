# Resend (https://resend.com) — envía los mails con el estilo de marca de
# LEVN cuando alguien completa el formulario de contacto o agenda una
# reunión (src/lib/email.ts + src/pages/api/send-email.ts).
# 1. Creá una cuenta gratis en resend.com (sin tarjeta, 3000 mails/mes).
# 2. Generá una API key en Dashboard → API Keys.
# 3. NO lleva prefijo PUBLIC_: esta key sólo corre en el servidor (la API
#    route), nunca se expone al navegador.
RESEND_API_KEY=

# A dónde llegan los mails del formulario y la agenda.
RESEND_TO_EMAIL=hola@levn.com.ar

# Remitente. Tiene que ser de un dominio verificado en Resend (levn.com.ar).
# OJO: el sandbox "onboarding@resend.dev" sólo puede enviar al mail dueño de
# la cuenta de Resend, así que con él NUNCA va a llegar a hola@levn.com.ar.
RESEND_FROM_EMAIL=LEVN <no-reply@levn.com.ar>

# Proyecto de Supabase (https://supabase.com) — guarda los leads del
# formulario de contacto y las reuniones agendadas, y le da al calendario
# la disponibilidad real (qué fechas/horarios ya están ocupados, y qué días
# están bloqueados a mano en la tabla blocked_dates).
# 1. Creá un proyecto gratis en supabase.com.
# 2. Corré supabase/schema.sql en el SQL Editor del proyecto.
# 3. Copiá la Project URL y la clave "anon public" desde Project Settings → API.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
