# Access key for https://web3forms.com — envía por email el formulario de
# contacto y las solicitudes de reunión, sin backend propio. Registrate
# gratis, verificá tu email de destino y pegá acá la access key.
PUBLIC_WEB3FORMS_KEY=

# Proyecto de Supabase (https://supabase.com) — guarda los leads del
# formulario de contacto y las reuniones agendadas, y le da al calendario
# la disponibilidad real (qué fechas/horarios ya están ocupados).
# 1. Creá un proyecto gratis en supabase.com.
# 2. Corré supabase/schema.sql en el SQL Editor del proyecto.
# 3. Copiá la Project URL y la clave "anon public" desde Project Settings → API.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
